<%- include('../partials/header', { title: 'Đăng ký' }) %>
<%- include('../partials/navbar') %>

<main class="container mx-auto px-4 py-10 flex justify-center items-center min-h-[70vh]">
    <div class="card w-full max-w-md bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title text-2xl justify-center mb-6 text-success">Đăng Ký Tài Khoản</h2>
            
            <% if (error) { %>
            <div class="alert alert-error mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span><%= error %></span>
            </div>
            <% } %>

            <form action="/auth/register" method="POST">
                <div class="form-control mb-4">
                    <label class="label"><span class="label-text">Họ và tên</span></label>
                    <input type="text" name="fullName" placeholder="Nguyễn Văn A" class="input input-bordered w-full" required autofocus />
                </div>

                <div class="form-control mb-4">
                    <label class="label"><span class="label-text">Email</span></label>
                    <input type="email" name="email" placeholder="email@example.com" class="input input-bordered w-full" required />
                </div>

                <div class="form-control mb-4">
                    <label class="label"><span class="label-text">Mật khẩu</span></label>
                    <input type="password" name="password" placeholder="••••••••" class="input input-bordered w-full" required minlength="6" />
                </div>

                <div class="form-control mt-6">
                    <button type="submit" class="btn btn-success text-white w-full">Đăng Ký</button>
                </div>
            </form>

            <div class="divider">HOẶC</div>

            <p class="text-center text-sm">
                Đã có tài khoản? <a href="/auth/login" class="link link-success">Đăng nhập</a>
            </p>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
