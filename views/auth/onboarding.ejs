<%- include('../partials/header', { title: title }) %>

<div class="min-h-screen bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 flex items-center justify-center px-4 py-12">

    <!-- Card chính -->
    <div class="w-full max-w-2xl">

        <!-- Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-success rounded-2xl shadow-lg mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">Thiết Lập Hồ Sơ Sức Khỏe</h1>
            <p class="text-gray-500 mt-2">Chào mừng, <span class="font-semibold text-success"><%= user.fullName %></span>! 
                Hãy cho chúng tôi biết thêm về bạn.</p>
        </div>

        <!-- Progress bar -->
        <div class="mb-6">
            <div class="flex items-center justify-between text-sm text-gray-500 mb-2">
                <span>Bước thiết lập ban đầu</span>
                <span class="font-medium text-success">Bước 1 / 1</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-success h-2 rounded-full transition-all duration-500" style="width: 100%"></div>
            </div>
        </div>

        <!-- Form card -->
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-green-100">

            <!-- Alert lỗi -->
            <% if (error) { %>
            <div class="alert alert-error mb-6 rounded-xl" id="errorAlert">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.538-1.333-3.308 0L3.732 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span><%= error %></span>
            </div>
            <% } %>

            <form id="onboardingForm" action="/onboarding" method="POST" novalidate>

                <!-- ── Thông tin cơ bản ─────────────────────────────── -->
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                        <span class="w-7 h-7 bg-success text-white rounded-full flex items-center justify-center text-sm font-bold">1</span>
                        Thông tin cơ bản
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <!-- Giới tính -->
                        <div class="form-control">
                            <label class="label" for="gender">
                                <span class="label-text font-medium">Giới tính <span class="text-error">*</span></span>
                            </label>
                            <select id="gender" name="gender" class="select select-bordered focus:select-success w-full" required>
                                <option value="" disabled selected>Chọn giới tính</option>
                                <option value="male">👨 Nam</option>
                                <option value="female">👩 Nữ</option>
                            </select>
                        </div>

                        <!-- Ngày sinh -->
                        <div class="form-control">
                            <label class="label" for="birthDate">
                                <span class="label-text font-medium">Ngày sinh <span class="text-error">*</span></span>
                            </label>
                            <input type="date" id="birthDate" name="birthDate"
                                   class="input input-bordered focus:input-success w-full"
                                   max="<%= new Date().toISOString().split('T')[0] %>"
                                   required />
                        </div>

                    </div>
                </div>

                <div class="divider"></div>

                <!-- ── Chỉ số thể chất ─────────────────────────────── -->
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                        <span class="w-7 h-7 bg-success text-white rounded-full flex items-center justify-center text-sm font-bold">2</span>
                        Chỉ số thể chất
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <!-- Chiều cao -->
                        <div class="form-control">
                            <label class="label" for="height">
                                <span class="label-text font-medium">Chiều cao <span class="text-error">*</span></span>
                            </label>
                            <label class="input input-bordered focus-within:input-success flex items-center gap-2 w-full">
                                <input type="number" id="height" name="height"
                                       class="grow" placeholder="Ví dụ: 170"
                                       min="50" max="300" step="0.1" required />
                                <span class="text-gray-400 font-medium text-sm">cm</span>
                            </label>
                        </div>

                        <!-- Cân nặng -->
                        <div class="form-control">
                            <label class="label" for="weight">
                                <span class="label-text font-medium">Cân nặng <span class="text-error">*</span></span>
                            </label>
                            <label class="input input-bordered focus-within:input-success flex items-center gap-2 w-full">
                                <input type="number" id="weight" name="weight"
                                       class="grow" placeholder="Ví dụ: 65"
                                       min="10" max="500" step="0.1" required />
                                <span class="text-gray-400 font-medium text-sm">kg</span>
                            </label>
                        </div>

                    </div>

                    <!-- BMI Preview (tính realtime) -->
                    <div id="bmiPreview" class="hidden mt-4 p-4 bg-green-50 rounded-xl border border-green-200">
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-600">Chỉ số BMI ước tính:</span>
                            <div class="text-right">
                                <span id="bmiValue" class="text-2xl font-bold text-success">--</span>
                                <span id="bmiCategory" class="block text-xs text-gray-500">--</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- ── Mức hoạt động & Mục tiêu ───────────────────── -->
                <div class="mb-8">
                    <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                        <span class="w-7 h-7 bg-success text-white rounded-full flex items-center justify-center text-sm font-bold">3</span>
                        Mức hoạt động & Mục tiêu
                    </h2>

                    <!-- Mức hoạt động (radio cards) -->
                    <div class="form-control mb-4">
                        <label class="label">
                            <span class="label-text font-medium">Mức hoạt động thể chất <span class="text-error">*</span></span>
                        </label>
                        <div class="grid grid-cols-1 gap-2" id="activityGroup">
                            <% 
                            const activities = [
                                { value: 'sedentary',   label: '🪑 Ít vận động',     desc: 'Ngồi nhiều, không tập thể dục', factor: '×1.2'  },
                                { value: 'light',       label: '🚶 Vận động nhẹ',     desc: '1-3 buổi/tuần',                factor: '×1.375'},
                                { value: 'moderate',    label: '🏃 Vận động vừa',     desc: '3-5 buổi/tuần',                factor: '×1.55' },
                                { value: 'active',      label: '🏋️ Vận động nhiều',   desc: '6-7 buổi/tuần',                factor: '×1.725'},
                                { value: 'very_active', label: '⚡ Vận động rất nhiều','desc': 'Vận động viên / lao động nặng',factor: '×1.9' },
                            ];
                            activities.forEach(a => { %>
                            <label class="activity-card cursor-pointer flex items-center gap-3 p-3 rounded-xl border-2 border-gray-200 hover:border-success hover:bg-green-50 transition-all duration-200">
                                <input type="radio" name="activityLevel" value="<%= a.value %>" class="radio radio-success hidden" required>
                                <div class="flex-1">
                                    <span class="font-medium text-gray-700 text-sm"><%= a.label %></span>
                                    <span class="text-gray-400 text-xs block"><%= a.desc %></span>
                                </div>
                                <span class="badge badge-success badge-outline text-xs font-mono"><%= a.factor %></span>
                            </label>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Mục tiêu -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium">Mục tiêu sức khỏe <span class="text-error">*</span></span>
                        </label>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3" id="goalGroup">
                            <%
                            const goals = [
                                { value: 'lose_weight',     emoji: '🔥', label: 'Giảm cân',    desc: 'Thâm hụt calo'   },
                                { value: 'maintain_weight', emoji: '⚖️', label: 'Duy trì',     desc: 'Cân bằng calo'   },
                                { value: 'gain_weight',     emoji: '💪', label: 'Tăng cơ/cân', desc: 'Thặng dư calo'   },
                            ];
                            goals.forEach(g => { %>
                            <label class="goal-card cursor-pointer flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-gray-200 hover:border-success hover:bg-green-50 transition-all duration-200 text-center">
                                <input type="radio" name="goal" value="<%= g.value %>" class="radio radio-success hidden" required>
                                <span class="text-3xl"><%= g.emoji %></span>
                                <span class="font-semibold text-gray-700 text-sm"><%= g.label %></span>
                                <span class="text-gray-400 text-xs"><%= g.desc %></span>
                            </label>
                            <% }); %>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" id="submitBtn" class="btn btn-success w-full text-white text-base font-semibold py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Hoàn Thành & Vào Dashboard
                </button>

            </form>
        </div>

        <!-- Footer note -->
        <p class="text-center text-gray-400 text-xs mt-4">
            Thông tin của bạn được bảo mật và chỉ dùng để tính toán dinh dưỡng cá nhân hóa.
        </p>

    </div>
</div>

<script>
(function () {
    'use strict';

    // ── BMI preview realtime ──────────────────────────────────────
    const heightInput = document.getElementById('height');
    const weightInput = document.getElementById('weight');
    const bmiPreview  = document.getElementById('bmiPreview');
    const bmiValue    = document.getElementById('bmiValue');
    const bmiCategory = document.getElementById('bmiCategory');

    function getBmiCategory(bmi) {
        if (bmi < 18.5) return { label: 'Thiếu cân', color: 'text-warning' };
        if (bmi < 25.0) return { label: 'Bình thường ✅', color: 'text-success' };
        if (bmi < 30.0) return { label: 'Thừa cân', color: 'text-warning' };
        return { label: 'Béo phì', color: 'text-error' };
    }

    function updateBmi() {
        const h = parseFloat(heightInput.value);
        const w = parseFloat(weightInput.value);
        if (h >= 50 && h <= 300 && w >= 10 && w <= 500) {
            const bmi = w / Math.pow(h / 100, 2);
            const cat = getBmiCategory(bmi);
            bmiValue.textContent = bmi.toFixed(1);
            bmiValue.className = 'text-2xl font-bold ' + cat.color;
            bmiCategory.textContent = cat.label;
            bmiPreview.classList.remove('hidden');
        } else {
            bmiPreview.classList.add('hidden');
        }
    }

    heightInput.addEventListener('input', updateBmi);
    weightInput.addEventListener('input', updateBmi);

    // ── Radio card highlight ──────────────────────────────────────
    function setupRadioCards(cardClass, radioName) {
        const cards = document.querySelectorAll('.' + cardClass);
        cards.forEach(card => {
            const radio = card.querySelector('input[type="radio"]');
            card.addEventListener('click', () => {
                // Bỏ active tất cả
                cards.forEach(c => {
                    c.classList.remove('border-success', 'bg-green-50');
                    c.classList.add('border-gray-200');
                });
                // Active card được chọn
                card.classList.add('border-success', 'bg-green-50');
                card.classList.remove('border-gray-200');
                radio.checked = true;
            });
        });
    }

    setupRadioCards('activity-card', 'activityLevel');
    setupRadioCards('goal-card', 'goal');

    // ── Form submit loading ───────────────────────────────────────
    const form = document.getElementById('onboardingForm');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', (e) => {
        // Kiểm tra radio được chọn
        const activitySelected = document.querySelector('input[name="activityLevel"]:checked');
        const goalSelected     = document.querySelector('input[name="goal"]:checked');

        if (!activitySelected || !goalSelected) {
            e.preventDefault();
            alert('Vui lòng chọn mức hoạt động và mục tiêu sức khỏe!');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Đang lưu...';
        document.getElementById('loadingOverlay').classList.add('active');
    });

    // Auto-dismiss error alert
    const errorAlert = document.getElementById('errorAlert');
    if (errorAlert) {
        setTimeout(() => {
            errorAlert.style.opacity = '0';
            errorAlert.style.transition = 'opacity 0.5s';
            setTimeout(() => errorAlert.remove(), 500);
        }, 5000);
    }
})();
</script>

<%- include('../partials/footer') %>
