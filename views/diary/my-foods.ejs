<%- include('../partials/header', { title: 'Món Ăn Của Tôi' }) %>
<%- include('../partials/navbar') %>

<main class="container mx-auto px-4 max-w-4xl py-6">

  <!-- ── Header ── -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">
        🔧 Món Ăn Của Tôi
      </h1>
      <p class="text-sm text-gray-500 mt-0.5 font-medium">Quản lý các món ăn tự tạo · Chỉ bạn mới thấy</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/nhat-ky" class="px-4 py-2 rounded-xl text-sm font-bold text-gray-600 hover:bg-gray-100 transition-all border border-gray-200">
        ← Về Nhật Ký
      </a>
      <button onclick="openCreateModal()"
              class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-black text-white transition-all hover:opacity-90 active:scale-95"
              style="background:linear-gradient(135deg,#7c3aed,#6d28d9);box-shadow:0 4px 12px rgba(124,58,237,0.3)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Tạo món mới
      </button>
    </div>
  </div>

  <!-- ── Empty State ── -->
  <% if (!foods || foods.length === 0) { %>
  <div class="nt-card p-12 text-center">
    <p class="text-5xl mb-4">🍳</p>
    <p class="font-black text-gray-600 text-lg mb-1">Chưa có món tự tạo nào</p>
    <p class="text-sm text-gray-400 mb-5">Tạo món ăn riêng để theo dõi dinh dưỡng chính xác hơn</p>
    <button onclick="openCreateModal()"
            class="px-6 py-3 rounded-xl text-sm font-black text-white"
            style="background:linear-gradient(135deg,#7c3aed,#6d28d9)">
      ✨ Tạo món đầu tiên
    </button>
  </div>
  <% } else { %>

  <!-- ── Food List ── -->
  <div class="space-y-3" id="foodList">
    <% foods.forEach(food => { %>
    <div class="nt-card p-4 flex items-center gap-4 hover:shadow-md transition-shadow" id="food-item-<%= food.id %>">
      <!-- Icon -->
      <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-white text-lg"
           style="background:linear-gradient(135deg,#7c3aed,#6d28d9)">
        🔧
      </div>
      <!-- Info -->
      <div class="flex-1 min-w-0">
        <p class="font-black text-gray-800 text-sm"><%= food.name %></p>
        <div class="flex items-center gap-2 flex-wrap mt-0.5">
          <span class="text-xs font-bold text-green-600"><%= food.calories %> kcal / <%= food.unit %></span>
          <span class="pill pill-blue">P:<%= food.protein %>g</span>
          <span class="pill pill-amber">C:<%= food.carbs %>g</span>
          <span class="pill pill-rose">F:<%= food.fat %>g</span>
          <% if (food.fiber != null) { %><span class="pill" style="background:#dcfce7;color:#15803d">Xơ:<%= food.fiber %>g</span><% } %>
          <% if (food.sugar != null) { %><span class="pill" style="background:#fef9c3;color:#a16207">Đ:<%= food.sugar %>g</span><% } %>
          <% if (food.sodium != null) { %><span class="pill" style="background:#dbeafe;color:#1d4ed8">Na:<%= food.sodium %>mg</span><% } %>
        </div>
        <p class="text-[10px] text-gray-400 mt-0.5">
          <%= food.foodType === 'raw' ? 'Nguyên liệu thô' : 'Món chế biến' %> ·
          Tạo: <%= new Date(food.createdAt).toLocaleDateString('vi-VN') %>
        </p>
      </div>
      <!-- Actions -->
      <div class="flex items-center gap-1 flex-shrink-0">
        <button onclick="openEditModal(<%= JSON.stringify(food).replace(/</g,'\\u003c') %>)"
                class="p-2 rounded-lg text-violet-500 hover:bg-violet-50 hover:text-violet-700 transition-all" title="Sửa">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </button>
        <button onclick="deleteFood(<%= food.id %>, '<%= food.name.replace(/'/g, "\\'") %>')"
                class="p-2 rounded-lg text-red-400 hover:bg-red-50 hover:text-red-600 transition-all" title="Xóa">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      </div>
    </div>
    <% }); %>
  </div>

  <% } %>
</main>

<!-- ═══ Modal Tạo / Sửa Món ═══════════════════════════════════════════ -->
<dialog id="foodFormModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-lg rounded-2xl p-6">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-gray-400">✕</button>
    </form>
    <h3 class="font-black text-lg text-gray-800 mb-5 flex items-center gap-2" id="modalTitle">
      <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-sm"
            style="background:linear-gradient(135deg,#7c3aed,#6d28d9)">🔧</span>
      Tạo Món Ăn Mới
    </h3>

    <form id="foodForm" class="space-y-4" onsubmit="return false">
      <input type="hidden" id="editFoodId">

      <!-- Tên món -->
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Tên món ăn <span class="text-red-500">*</span></label>
        <input type="text" id="f_name" placeholder="VD: Cơm chiên gà tự nấu" class="nt-input text-sm" maxlength="200">
      </div>

      <!-- Macros bắt buộc -->
      <div>
        <p class="text-xs font-bold text-gray-500 mb-2 uppercase tracking-wide">⚡ Dinh dưỡng chính <span class="text-red-500">*</span></p>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-gray-500 mb-1">Calories (kcal)</label>
            <input type="number" id="f_calories" placeholder="0" min="0" step="0.1" class="nt-input text-sm" oninput="calcMacroCheck()">
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Protein (g)</label>
            <input type="number" id="f_protein" placeholder="0" min="0" step="0.1" class="nt-input text-sm">
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Carbs (g)</label>
            <input type="number" id="f_carbs" placeholder="0" min="0" step="0.1" class="nt-input text-sm">
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Fat (g)</label>
            <input type="number" id="f_fat" placeholder="0" min="0" step="0.1" class="nt-input text-sm">
          </div>
        </div>
      </div>

      <!-- Vi chất tùy chọn -->
      <details class="rounded-xl border border-gray-100 overflow-hidden">
        <summary class="px-4 py-2.5 text-xs font-bold text-gray-500 cursor-pointer hover:bg-gray-50 select-none">
          🔬 Vi chất (tùy chọn — Chất xơ, Đường, Natri)
        </summary>
        <div class="px-4 pb-4 pt-2 grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs text-gray-500 mb-1">🌿 Chất xơ (g)</label>
            <input type="number" id="f_fiber" placeholder="–" min="0" step="0.1" class="nt-input text-sm">
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">🍬 Đường (g)</label>
            <input type="number" id="f_sugar" placeholder="–" min="0" step="0.1" class="nt-input text-sm">
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">🧂 Natri (mg)</label>
            <input type="number" id="f_sodium" placeholder="–" min="0" step="1" class="nt-input text-sm">
          </div>
        </div>
      </details>

      <!-- Phân loại -->
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Đơn vị</label>
          <input type="text" id="f_unit" placeholder="1 suất" class="nt-input text-sm" value="1 suất">
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Nhóm</label>
          <select id="f_category" class="nt-select text-sm w-full">
            <option value="com">Cơm & Xôi</option>
            <option value="pho_bun">Phở, Bún</option>
            <option value="banh">Bánh</option>
            <option value="thit_ca">Thịt & Cá</option>
            <option value="rau_cu">Rau củ</option>
            <option value="do_uong">Đồ uống</option>
            <option value="trai_cay">Trái cây</option>
            <option value="protein">Đạm (thô)</option>
            <option value="carb">Tinh bột (thô)</option>
            <option value="fat">Chất béo (thô)</option>
            <option value="fiber">Chất xơ (thô)</option>
            <option value="khac" selected>Khác</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Loại</label>
          <select id="f_foodType" class="nt-select text-sm w-full">
            <option value="dish" selected>Chế biến</option>
            <option value="raw">Thô</option>
          </select>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex gap-2 pt-1">
        <button type="button" onclick="document.getElementById('foodFormModal').close()"
                class="flex-1 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:bg-gray-100 transition-all border border-gray-200">Hủy</button>
        <button type="button" id="submitFoodBtn" onclick="submitFoodForm()"
                class="flex-1 py-2.5 rounded-xl text-sm font-black text-white transition-all active:scale-95"
                style="background:linear-gradient(135deg,#7c3aed,#6d28d9);box-shadow:0 4px 12px rgba(124,58,237,0.3)">
          ✅ Lưu Món Ăn
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>đóng</button></form>
</dialog>

<script>
let _editMode = false;

function openCreateModal() {
  _editMode = false;
  document.getElementById('modalTitle').innerHTML =
    '<span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-sm" style="background:linear-gradient(135deg,#7c3aed,#6d28d9)">🔧</span> Tạo Món Ăn Mới';
  document.getElementById('editFoodId').value = '';
  ['f_name','f_calories','f_protein','f_carbs','f_fat','f_fiber','f_sugar','f_sodium'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = id === 'f_name' ? '' : '';
  });
  document.getElementById('f_unit').value = '1 suất';
  document.getElementById('f_category').value = 'khac';
  document.getElementById('f_foodType').value = 'dish';
  document.getElementById('foodFormModal').showModal();
  setTimeout(() => document.getElementById('f_name').focus(), 100);
}

function openEditModal(food) {
  _editMode = true;
  document.getElementById('modalTitle').innerHTML =
    '<span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-sm" style="background:linear-gradient(135deg,#7c3aed,#6d28d9)">✏️</span> Sửa Món Ăn';
  document.getElementById('editFoodId').value = food.id;
  document.getElementById('f_name').value     = food.name;
  document.getElementById('f_calories').value = food.calories;
  document.getElementById('f_protein').value  = food.protein;
  document.getElementById('f_carbs').value    = food.carbs;
  document.getElementById('f_fat').value      = food.fat;
  document.getElementById('f_fiber').value    = food.fiber  ?? '';
  document.getElementById('f_sugar').value    = food.sugar  ?? '';
  document.getElementById('f_sodium').value   = food.sodium ?? '';
  document.getElementById('f_unit').value     = food.unit;
  document.getElementById('f_category').value = food.category;
  document.getElementById('f_foodType').value = food.foodType;
  document.getElementById('foodFormModal').showModal();
}

async function submitFoodForm() {
  const name = document.getElementById('f_name').value.trim();
  if (!name) { showToast('Vui lòng nhập tên món ăn.', 'warning'); return; }

  const body = {
    name,
    calories : document.getElementById('f_calories').value,
    protein  : document.getElementById('f_protein').value,
    carbs    : document.getElementById('f_carbs').value,
    fat      : document.getElementById('f_fat').value,
    fiber    : document.getElementById('f_fiber').value  || null,
    sugar    : document.getElementById('f_sugar').value  || null,
    sodium   : document.getElementById('f_sodium').value || null,
    unit     : document.getElementById('f_unit').value   || '1 suất',
    category : document.getElementById('f_category').value,
    foodType : document.getElementById('f_foodType').value,
  };

  const editId = document.getElementById('editFoodId').value;
  const url    = _editMode ? `/nhat-ky/sua-mon/${editId}` : '/nhat-ky/tao-mon';
  const method = _editMode ? 'PUT' : 'POST';

  try {
    showLoading();
    const res  = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      showToast(data.message, 'success');
      document.getElementById('foodFormModal').close();
      setTimeout(() => location.reload(), 800);
    } else {
      showToast(data.message || 'Có lỗi xảy ra.', 'error');
    }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.', 'error'); }
}

async function deleteFood(id, name) {
  if (!confirm(`Xóa món "${name}"?\n\nLịch sử nhật ký cũ vẫn được bảo tồn.`)) return;
  try {
    showLoading();
    const res  = await fetch(`/nhat-ky/xoa-mon/${id}`, { method: 'DELETE' });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      showToast(data.message, 'success');
      const el = document.getElementById(`food-item-${id}`);
      if (el) {
        el.style.transition = 'all 0.3s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateX(20px)';
        setTimeout(() => el.remove(), 300);
      }
    } else {
      showToast(data.message || 'Lỗi.', 'error');
    }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.', 'error'); }
}
</script>

<%- include('../partials/footer') %>
