<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- ═══════════════════════════════════════════════════════════════════════════
     views/diary/index.ejs — Nhật Ký Ăn Uống
     ═══════════════════════════════════════════════════════════════════════════ -->

<main class="container mx-auto px-4 max-w-5xl py-6 pb-28 md:pb-10">

    <!-- ── Header + Date Picker ─────────────────────────────────────────────── -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-success flex items-center gap-2">
                📔 Nhật Ký Ăn Uống
            </h1>
            <p class="text-sm text-base-content/60 mt-0.5">Theo dõi từng bữa ăn trong ngày</p>
        </div>

        <!-- Date Picker -->
        <form method="GET" action="/nhat-ky" class="flex items-center gap-2">
            <input type="date" name="date" id="dateInput"
                   value="<%= date %>"
                   max="<%= (d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`)(new Date()) %>"
                   class="input input-bordered input-sm"
                   onchange="this.form.submit()">
            <button type="button" onclick="goToToday()"
                    class="btn btn-ghost btn-sm text-success font-medium">
                Hôm nay
            </button>
        </form>
    </div>

    <!-- ── Tóm tắt calo ngày ─────────────────────────────────────────────────── -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        <!-- Calo đã nạp -->
        <div class="card bg-white shadow-sm border border-base-200 card-hover">
            <div class="card-body p-4">
                <p class="text-xs text-base-content/50 font-medium uppercase tracking-wide">Đã nạp</p>
                <p class="text-2xl font-bold text-success"><%= consumed.calories %></p>
                <p class="text-xs text-base-content/50">kcal</p>
            </div>
        </div>
        <!-- Mục tiêu -->
        <div class="card bg-white shadow-sm border border-base-200 card-hover">
            <div class="card-body p-4">
                <p class="text-xs text-base-content/50 font-medium uppercase tracking-wide">Mục tiêu</p>
                <p class="text-2xl font-bold text-primary"><%= metrics.targetCalories || '–' %></p>
                <p class="text-xs text-base-content/50">kcal/ngày</p>
            </div>
        </div>
        <!-- Còn lại -->
        <div class="card bg-white shadow-sm border border-base-200 card-hover">
            <div class="card-body p-4">
                <p class="text-xs text-base-content/50 font-medium uppercase tracking-wide">Còn lại</p>
                <% const remaining = (metrics.targetCalories || 0) - consumed.calories; %>
                <p class="text-2xl font-bold <%= remaining < 0 ? 'text-error' : 'text-warning' %>">
                    <%= remaining >= 0 ? remaining : 0 %>
                </p>
                <p class="text-xs text-base-content/50">kcal</p>
            </div>
        </div>
        <!-- Tiến độ -->
        <div class="card bg-white shadow-sm border border-base-200 card-hover">
            <div class="card-body p-4">
                <p class="text-xs text-base-content/50 font-medium uppercase tracking-wide">Tiến độ</p>
                <p class="text-2xl font-bold <%= calorieProgress >= 100 ? 'text-error' : 'text-info' %>">
                    <%= calorieProgress %>%
                </p>
                <progress class="progress progress-success w-full mt-1" value="<%= calorieProgress %>" max="100"></progress>
            </div>
        </div>
    </div>

    <!-- ── Thanh macro ────────────────────────────────────────────────────────── -->
    <% if (metrics.macros && metrics.targetCalories) { %>
    <div class="card bg-white shadow-sm border border-base-200 mb-6">
        <div class="card-body p-4">
            <h3 class="font-semibold text-sm text-base-content/70 mb-3">⚡ Phân bổ Macros hôm nay</h3>
            <div class="grid grid-cols-3 gap-4">
                <!-- Protein -->
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="font-medium text-blue-600">🥩 Protein</span>
                        <span class="text-base-content/60"><%= consumed.protein %>/<%= metrics.macros.protein %>g</span>
                    </div>
                    <progress class="progress progress-info w-full" value="<%= macroProgress.protein %>" max="100"></progress>
                    <p class="text-xs text-base-content/40 mt-0.5"><%= macroProgress.protein %>%</p>
                </div>
                <!-- Carbs -->
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="font-medium text-amber-600">🍚 Carbs</span>
                        <span class="text-base-content/60"><%= consumed.carbs %>/<%= metrics.macros.carbs %>g</span>
                    </div>
                    <progress class="progress progress-warning w-full" value="<%= macroProgress.carbs %>" max="100"></progress>
                    <p class="text-xs text-base-content/40 mt-0.5"><%= macroProgress.carbs %>%</p>
                </div>
                <!-- Fat -->
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span class="font-medium text-rose-600">🥑 Fat</span>
                        <span class="text-base-content/60"><%= consumed.fat %>/<%= metrics.macros.fat %>g</span>
                    </div>
                    <progress class="progress progress-error w-full" value="<%= macroProgress.fat %>" max="100"></progress>
                    <p class="text-xs text-base-content/40 mt-0.5"><%= macroProgress.fat %>%</p>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- ── Các bữa ăn trong ngày ─────────────────────────────────────────────── -->
    <div class="grid md:grid-cols-2 gap-4 mb-6">
        <% const mealConfig = [
            { key: 'sang', label: 'Bữa Sáng', icon: '🌅', color: 'bg-amber-50 border-amber-200' },
            { key: 'trua', label: 'Bữa Trưa', icon: '☀️', color: 'bg-green-50 border-green-200' },
            { key: 'toi',  label: 'Bữa Tối',  icon: '🌙', color: 'bg-indigo-50 border-indigo-200' },
            { key: 'phu',  label: 'Bữa Phụ',  icon: '🍎', color: 'bg-rose-50 border-rose-200' },
        ]; %>

        <% mealConfig.forEach(meal => { %>
        <div class="card bg-white shadow-sm border border-base-200">
            <div class="card-body p-4">
                <!-- Meal Header -->
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <span class="text-lg"><%= meal.icon %></span>
                        <div>
                            <h3 class="font-semibold text-sm"><%= meal.label %></h3>
                            <p class="text-xs text-base-content/50"><%= mealCalories[meal.key] %> kcal</p>
                        </div>
                    </div>
                    <button onclick="openAddModal('<%= meal.key %>')"
                            class="btn btn-success btn-xs text-white gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"/>
                        </svg>
                        Thêm
                    </button>
                </div>

                <!-- Danh sách món ăn trong bữa -->
                <% if (mealGroups[meal.key] && mealGroups[meal.key].length > 0) { %>
                    <div class="space-y-2">
                        <% mealGroups[meal.key].forEach(entry => { %>
                        <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-base-50 border border-base-200 hover:bg-base-100 transition-colors group"
                             id="entry-<%= entry.id %>">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium truncate">
                                    <%= entry.food ? entry.food.name : 'Món không xác định' %>
                                </p>
                                <p class="text-xs text-base-content/50">
                                    <%= entry.amount %> <%= entry.food ? entry.food.unit : '' %>
                                    · <strong><%= Math.round(entry.caloriesSnapshot || 0) %></strong> kcal
                                    · P: <%= Math.round(entry.proteinSnapshot || 0) %>g
                                    · C: <%= Math.round(entry.carbsSnapshot || 0) %>g
                                    · F: <%= Math.round(entry.fatSnapshot || 0) %>g
                                </p>
                            </div>
                            <button onclick="deleteEntry(<%= entry.id %>)"
                                    class="btn btn-ghost btn-xs text-error opacity-0 group-hover:opacity-100 transition-opacity ml-2"
                                    title="Xóa">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-4 text-base-content/30 text-sm">
                        <p>Chưa có món nào</p>
                    </div>
                <% } %>
            </div>
        </div>
        <% }); %>
    </div>

    <!-- ── Gợi ý món ăn ──────────────────────────────────────────────────────── -->
    <% if (suggestions && suggestions.length > 0) { %>
    <div class="card bg-gradient-to-br from-green-50 to-emerald-50 border border-green-200 shadow-sm mb-6">
        <div class="card-body p-4">
            <h3 class="font-semibold text-success flex items-center gap-2 mb-3">
                💡 Gợi ý bữa tiếp theo
                <span class="badge badge-success badge-sm text-white">
                    Còn <%= (metrics.targetCalories || 0) - consumed.calories %> kcal
                </span>
            </h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <% suggestions.forEach(s => { %>
                <div class="card bg-white shadow-sm border border-green-100 card-hover cursor-pointer"
                     onclick="quickAdd(<%= JSON.stringify({ id: s.food.id, name: s.food.name, calories: s.food.calories, unit: s.food.unit }).replace(/"/g, '&quot;') %>)">
                    <div class="card-body p-3">
                        <p class="font-medium text-sm truncate"><%= s.food.name %></p>
                        <p class="text-xs text-base-content/50">
                            <strong class="text-success"><%= s.food.calories %></strong> kcal / <%= s.food.unit %>
                        </p>
                        <div class="flex gap-1 flex-wrap mt-1">
                            <span class="badge badge-xs badge-outline">P: <%= s.food.protein %>g</span>
                            <span class="badge badge-xs badge-outline">C: <%= s.food.carbs %>g</span>
                            <span class="badge badge-xs badge-outline">F: <%= s.food.fat %>g</span>
                        </div>
                        <p class="text-xs text-success/70 mt-1">Còn sau: <%= s.remainingAfter %> kcal</p>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>
    <% } else if (consumed.calories > 0 && calorieProgress >= 100) { %>
    <div class="alert alert-success shadow-sm mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>🎉 Bạn đã đạt mục tiêu calo hôm nay! Tuyệt vời!</span>
    </div>
    <% } %>

</main>

<!-- ═══════════════════════════════════════════════════════════════════════════
     Modal Thêm Món Ăn
     ═══════════════════════════════════════════════════════════════════════════ -->
<dialog id="addFoodModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-lg">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3">✕</button>
        </form>
        <h3 class="font-bold text-lg text-success mb-4">➕ Thêm Món Ăn</h3>

        <!-- Search -->
        <div class="form-control mb-3">
            <label class="label"><span class="label-text font-medium">Tìm kiếm món ăn</span></label>
            <div class="join w-full">
                <input type="text" id="searchFoodInput"
                       placeholder="Nhập tên món (ví dụ: cơm, phở, thịt...)"
                       class="input input-bordered join-item flex-1"
                       oninput="debounceSearch(this.value)"
                       autocomplete="off">
                <select id="categoryFilter" class="select select-bordered join-item w-28"
                        onchange="debounceSearch(document.getElementById('searchFoodInput').value)">
                    <option value="">Tất cả</option>
                    <option value="com">Cơm & Xôi</option>
                    <option value="pho_bun">Phở, Bún</option>
                    <option value="banh">Bánh</option>
                    <option value="rau_cu">Rau củ</option>
                    <option value="thit_ca">Thịt & Cá</option>
                    <option value="do_uong">Đồ uống</option>
                    <option value="trai_cay">Trái cây</option>
                    <option value="khac">Khác</option>
                </select>
            </div>
        </div>

        <!-- Search Results -->
        <div id="searchResults" class="max-h-48 overflow-y-auto border border-base-200 rounded-lg mb-4 hidden">
            <div id="searchResultsList" class="divide-y divide-base-200"></div>
        </div>

        <!-- Selected Food Preview -->
        <div id="selectedFoodPreview" class="hidden bg-green-50 border border-green-200 rounded-lg p-3 mb-4">
            <p class="font-semibold text-success text-sm" id="selectedFoodName">–</p>
            <p class="text-xs text-base-content/60" id="selectedFoodMacros">–</p>
        </div>

        <!-- Form nhập -->
        <form id="addFoodForm" class="space-y-3">
            <input type="hidden" id="selectedFoodId" value="">

            <div class="grid grid-cols-2 gap-3">
                <div class="form-control">
                    <label class="label"><span class="label-text font-medium text-sm">Số lượng</span></label>
                    <input type="number" id="foodAmount" value="1" min="0.1" step="0.1"
                           class="input input-bordered input-sm"
                           oninput="updateCaloriePreview()">
                </div>
                <div class="form-control">
                    <label class="label"><span class="label-text font-medium text-sm">Bữa ăn</span></label>
                    <select id="foodMealType" class="select select-bordered select-sm">
                        <option value="sang">🌅 Bữa sáng</option>
                        <option value="trua">☀️ Bữa trưa</option>
                        <option value="toi">🌙 Bữa tối</option>
                        <option value="phu">🍎 Bữa phụ</option>
                    </select>
                </div>
            </div>

            <!-- Calo preview -->
            <div id="caloriePreview" class="hidden text-center py-2 bg-success/10 rounded-lg">
                <p class="text-sm">Tổng: <strong class="text-success text-base" id="previewCalories">0</strong> kcal</p>
            </div>

            <div class="form-control">
                <label class="label"><span class="label-text font-medium text-sm">Ghi chú (tùy chọn)</span></label>
                <input type="text" id="foodNote" placeholder="Ví dụ: thêm đường, bỏ hành..."
                       class="input input-bordered input-sm">
            </div>

            <div class="modal-action mt-4">
                <button type="button" onclick="document.getElementById('addFoodModal').close()"
                        class="btn btn-ghost btn-sm">Hủy</button>
                <button type="button" onclick="submitAddFood()"
                        class="btn btn-success btn-sm text-white gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Thêm vào nhật ký
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>đóng</button></form>
</dialog>

<!-- Toast notification -->
<div id="toast" class="toast toast-top toast-end z-50 hidden">
    <div id="toastAlert" class="alert shadow-lg">
        <span id="toastMsg"></span>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     JavaScript
     ═══════════════════════════════════════════════════════════════════════════ -->
<script>
    const CURRENT_DATE = '<%= date %>';
    let selectedFood   = null;
    let searchTimer    = null;

    // ── Điều hướng ngày ────────────────────────────────────────────────────────
    function goToToday() {
        // Dùng local date (không dùng toISOString để tránh lệch timezone UTC+7)
        const d     = new Date();
        const today = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
        window.location.href = '/nhat-ky?date=' + today;
    }

    // ── Mở modal thêm món, set sẵn bữa ăn ────────────────────────────────────
    function openAddModal(mealType) {
        selectedFood = null;
        document.getElementById('selectedFoodId').value = '';
        document.getElementById('searchFoodInput').value = '';
        document.getElementById('searchResults').classList.add('hidden');
        document.getElementById('selectedFoodPreview').classList.add('hidden');
        document.getElementById('caloriePreview').classList.add('hidden');
        document.getElementById('foodAmount').value = '1';
        document.getElementById('foodNote').value = '';

        // Set bữa ăn mặc định
        const select = document.getElementById('foodMealType');
        if (mealType) select.value = mealType;

        document.getElementById('addFoodModal').showModal();
        setTimeout(() => document.getElementById('searchFoodInput').focus(), 100);
    }

    // ── Gợi ý nhanh từ card suggestions ──────────────────────────────────────
    function quickAdd(foodData) {
        openAddModal(null);
        // Điền food vào form
        setTimeout(() => {
            selectFood(foodData);
        }, 150);
    }

    // ── Tìm kiếm món ăn (debounce 300ms) ─────────────────────────────────────
    function debounceSearch(query) {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => searchFood(query), 300);
    }

    async function searchFood(query) {
        const category = document.getElementById('categoryFilter').value;
        const params   = new URLSearchParams({ q: query, category, limit: 15 });

        try {
            const res   = await fetch('/nhat-ky/tim-mon?' + params);
            const data  = await res.json();
            renderSearchResults(data.foods || []);
        } catch (err) {
            console.error('Search error:', err);
        }
    }

    function renderSearchResults(foods) {
        const container = document.getElementById('searchResultsList');
        const wrapper   = document.getElementById('searchResults');

        if (foods.length === 0) {
            container.innerHTML = '<p class="text-center text-sm text-base-content/40 py-4">Không tìm thấy món ăn phù hợp</p>';
            wrapper.classList.remove('hidden');
            return;
        }

        container.innerHTML = foods.map(f => {
            // [A1 FIX] Dùng data-* attribute thay vì inline JSON trong onclick
            // Tránh lỗi khi food.name chứa single quote phá vỡ onclick='...'
            const safeJson = JSON.stringify(f).replace(/</g,'\\u003c').replace(/>/g,'\\u003e');
            return `
            <button type="button"
                    class="w-full text-left px-4 py-2.5 hover:bg-green-50 transition-colors"
                    data-food='${safeJson.replace(/'/g, '\\u0027')}'
                    onclick="selectFood(JSON.parse(this.dataset.food))">
                <p class="font-medium text-sm">${f.name.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</p>
                <p class="text-xs text-base-content/50">${f.calories} kcal / ${f.unit} · P:${f.protein}g C:${f.carbs}g F:${f.fat}g</p>
            </button>`;
        }).join('');
        wrapper.classList.remove('hidden');
    }

    // ── Chọn món ăn từ kết quả tìm kiếm ─────────────────────────────────────
    function selectFood(food) {
        selectedFood = food;
        document.getElementById('selectedFoodId').value = food.id;
        document.getElementById('searchFoodInput').value = food.name;
        document.getElementById('searchResults').classList.add('hidden');

        document.getElementById('selectedFoodName').textContent = food.name;
        document.getElementById('selectedFoodMacros').textContent =
            `${food.calories} kcal / ${food.unit} · Protein: ${food.protein}g · Carbs: ${food.carbs}g · Fat: ${food.fat}g`;
        document.getElementById('selectedFoodPreview').classList.remove('hidden');

        updateCaloriePreview();
        document.getElementById('foodAmount').focus();
    }

    // ── Cập nhật preview calo ─────────────────────────────────────────────────
    function updateCaloriePreview() {
        if (!selectedFood) return;
        const amount   = parseFloat(document.getElementById('foodAmount').value) || 0;
        const calories = Math.round(selectedFood.calories * amount);
        document.getElementById('previewCalories').textContent = calories;
        document.getElementById('caloriePreview').classList.remove('hidden');
    }

    // ── Submit thêm món ───────────────────────────────────────────────────────
    async function submitAddFood() {
        const foodId   = document.getElementById('selectedFoodId').value;
        const amount   = document.getElementById('foodAmount').value;
        const mealType = document.getElementById('foodMealType').value;
        const note     = document.getElementById('foodNote').value;

        if (!foodId) {
            showToast('Vui lòng chọn một món ăn.', 'warning');
            return;
        }
        if (!amount || parseFloat(amount) <= 0) {
            showToast('Số lượng phải lớn hơn 0.', 'warning');
            return;
        }

        try {
            showLoading();
            const res  = await fetch('/nhat-ky/them', {
                method : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body   : JSON.stringify({ foodId, amount, mealType, date: CURRENT_DATE, note }),
            });
            const data = await res.json();
            hideLoading();

            if (data.success) {
                document.getElementById('addFoodModal').close();
                showToast(data.message, 'success');
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(data.message || 'Có lỗi xảy ra.', 'error');
            }
        } catch (err) {
            hideLoading();
            showToast('Lỗi kết nối. Vui lòng thử lại.', 'error');
        }
    }

    // ── Xóa entry ─────────────────────────────────────────────────────────────
    async function deleteEntry(id) {
        if (!confirm('Bạn có chắc muốn xóa mục này không?')) return;

        try {
            showLoading();
            const res  = await fetch(`/nhat-ky/xoa/${id}`, { method: 'DELETE' });
            const data = await res.json();
            hideLoading();

            if (data.success) {
                const el = document.getElementById(`entry-${id}`);
                if (el) {
                    el.style.transition = 'opacity 0.3s ease, height 0.3s ease';
                    el.style.opacity = '0';
                    setTimeout(() => { el.remove(); location.reload(); }, 350);
                }
                showToast(data.message, 'success');
            } else {
                showToast(data.message || 'Có lỗi xảy ra.', 'error');
            }
        } catch (err) {
            hideLoading();
            showToast('Lỗi kết nối.', 'error');
        }
    }

    // ── Toast notification ────────────────────────────────────────────────────
    function showToast(msg, type = 'info') {
        const toast = document.getElementById('toast');
        const alert = document.getElementById('toastAlert');
        const span  = document.getElementById('toastMsg');

        span.textContent = msg;
        alert.className  = `alert alert-${type} shadow-lg`;
        toast.classList.remove('hidden');

        setTimeout(() => toast.classList.add('hidden'), 3500);
    }

    // ── Load danh sách món ngay khi mở modal (nếu chưa tìm) ──────────────────
    document.getElementById('addFoodModal').addEventListener('show', () => {
        searchFood('');
    });
    // Khi modal mở (click + button), load ngay
    document.querySelectorAll('[onclick^="openAddModal"]').forEach(btn => {
        // handled by openAddModal
    });
</script>

<%- include('../partials/footer') %>
