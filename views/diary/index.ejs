<%- include('../partials/header', { title: 'Nhật Ký Ăn Uống' }) %>
<%- include('../partials/navbar') %>

<main class="container mx-auto px-4 max-w-5xl py-6">

  <!-- ── Page Header ────────────────────────────────────────── -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">
        📔 Nhật Ký Ăn Uống
      </h1>
      <p class="text-sm text-gray-500 mt-0.5 font-medium">Theo dõi từng bữa ăn trong ngày</p>
    </div>
    <!-- Date Picker -->
    <form method="GET" action="/nhat-ky" class="flex items-center gap-2">
      <input type="date" name="date" id="dateInput" value="<%= date %>"
             max="<%= (d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`)(new Date()) %>"
             class="nt-input !w-auto text-sm font-semibold" onchange="this.form.submit()">
      <button type="button" onclick="goToToday()"
              class="px-3 py-2 rounded-xl text-sm font-bold text-green-600 hover:bg-green-50 transition-all border-2 border-green-200 hover:border-green-400">
        Hôm nay
      </button>
    </form>
  </div>

  <!-- ── Stat Cards ─────────────────────────────────────────── -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
    <div class="stat-card green">
      <p class="stat-label">Đã nạp</p>
      <p class="stat-value text-green-600 animated-num"><%= consumed.calories %></p>
      <p class="stat-sub">kcal</p>
    </div>
    <div class="stat-card blue">
      <p class="stat-label">Mục tiêu</p>
      <p class="stat-value text-blue-600 animated-num"><%= metrics.targetCalories || '–' %></p>
      <p class="stat-sub">kcal / ngày</p>
    </div>
    <div class="stat-card amber">
      <p class="stat-label">Còn lại</p>
      <% const remaining = (metrics.targetCalories || 0) - consumed.calories; %>
      <p class="stat-value <%= remaining < 0 ? 'text-red-500' : 'text-amber-600' %> animated-num">
        <%= remaining >= 0 ? remaining : 0 %>
      </p>
      <p class="stat-sub">kcal</p>
    </div>
    <div class="stat-card <%= calorieProgress >= 100 ? 'rose' : 'green' %>">
      <p class="stat-label">Tiến độ</p>
      <p class="stat-value <%= calorieProgress >= 100 ? 'text-red-500' : 'text-green-600' %> animated-num"><%= calorieProgress %>%</p>
      <div class="macro-bar-track mt-1.5">
        <div class="macro-bar-fill <%= calorieProgress >= 100 ? 'bg-red-400' : 'bg-green-500' %>"
             style="width:<%= Math.min(calorieProgress,100) %>%"></div>
      </div>
    </div>
  </div>

  <!-- ── Macro Bars ─────────────────────────────────────────── -->
  <% if (metrics.macros && metrics.targetCalories) { %>
  <div class="nt-card p-4 mb-5">
    <p class="section-title mb-4">⚡ Phân bổ Macros hôm nay</p>
    <div class="grid grid-cols-3 gap-4">
      <div>
        <div class="flex justify-between text-xs mb-1.5">
          <span class="font-bold text-blue-600">🥩 Protein</span>
          <span class="text-gray-400 font-semibold"><%= consumed.protein %>/<%= metrics.macros.protein %>g</span>
        </div>
        <div class="macro-bar-track"><div class="macro-bar-fill bg-blue-500" style="width:<%= macroProgress.protein %>%"></div></div>
        <p class="text-xs text-blue-400 mt-1 font-bold"><%= macroProgress.protein %>%</p>
      </div>
      <div>
        <div class="flex justify-between text-xs mb-1.5">
          <span class="font-bold text-amber-600">🍚 Carbs</span>
          <span class="text-gray-400 font-semibold"><%= consumed.carbs %>/<%= metrics.macros.carbs %>g</span>
        </div>
        <div class="macro-bar-track"><div class="macro-bar-fill bg-amber-400" style="width:<%= macroProgress.carbs %>%"></div></div>
        <p class="text-xs text-amber-400 mt-1 font-bold"><%= macroProgress.carbs %>%</p>
      </div>
      <div>
        <div class="flex justify-between text-xs mb-1.5">
          <span class="font-bold text-rose-600">🥑 Fat</span>
          <span class="text-gray-400 font-semibold"><%= consumed.fat %>/<%= metrics.macros.fat %>g</span>
        </div>
        <div class="macro-bar-track"><div class="macro-bar-fill bg-rose-400" style="width:<%= macroProgress.fat %>%"></div></div>
        <p class="text-xs text-rose-400 mt-1 font-bold"><%= macroProgress.fat %>%</p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Meal Cards Grid ────────────────────────────────────── -->
  <% const mealConfig = [
    { key:'sang', label:'Bữa Sáng', icon:'🌅', accent:'#d97706', bg:'linear-gradient(135deg,#fffbeb,#fef3c7)', border:'#fde68a' },
    { key:'trua', label:'Bữa Trưa', icon:'☀️', accent:'#15803d', bg:'linear-gradient(135deg,#f0fdf4,#dcfce7)', border:'#86efac' },
    { key:'toi',  label:'Bữa Tối',  icon:'🌙', accent:'#4f46e5', bg:'linear-gradient(135deg,#eef2ff,#e0e7ff)', border:'#a5b4fc' },
    { key:'phu',  label:'Bữa Phụ',  icon:'🍎', accent:'#be123c', bg:'linear-gradient(135deg,#fff1f2,#ffe4e6)', border:'#fca5a5' },
  ]; %>
  <div class="grid md:grid-cols-2 gap-4 mb-5">
    <% mealConfig.forEach(meal => { %>
    <div class="meal-card">
      <!-- Header -->
      <div class="meal-card-header" style="background:<%= meal.bg %>">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl"><%= meal.icon %></span>
          <div>
            <h3 class="font-black text-sm text-gray-800"><%= meal.label %></h3>
            <p class="text-xs font-bold" style="color:<%= meal.accent %>"><%= mealCalories[meal.key] %> kcal</p>
          </div>
        </div>
        <button onclick="openAddModal('<%= meal.key %>')"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-black text-white transition-all hover:opacity-90 active:scale-95"
                style="background:<%= meal.accent %>;box-shadow:0 2px 8px rgba(0,0,0,0.15)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          Thêm
        </button>
      </div>
      <!-- Food rows -->
      <% if (mealGroups[meal.key] && mealGroups[meal.key].length > 0) { %>
        <% mealGroups[meal.key].forEach(entry => { %>
        <div class="food-row" id="entry-<%= entry.id %>">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-800 truncate">
              <%= entry.food ? entry.food.name : 'Món không xác định' %>
            </p>
            <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
              <span class="text-xs text-gray-400 font-medium"><%= entry.amount %> <%= entry.food ? entry.food.unit : '' %></span>
              <span class="text-xs font-black text-green-600"><%= Math.round(entry.caloriesSnapshot||0) %> kcal</span>
              <span class="pill pill-blue">P:<%= Math.round(entry.proteinSnapshot||0) %>g</span>
              <span class="pill pill-amber">C:<%= Math.round(entry.carbsSnapshot||0) %>g</span>
              <span class="pill pill-rose">F:<%= Math.round(entry.fatSnapshot||0) %>g</span>
            </div>
          </div>
          <button onclick="deleteEntry(<%= entry.id %>)" class="del-btn ml-2 p-1.5 rounded-lg text-red-400 hover:bg-red-50 hover:text-red-600 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
        <% }); %>
      <% } else { %>
        <div class="text-center py-6 text-gray-300">
          <p class="text-3xl mb-1"><%= meal.icon %></p>
          <p class="text-sm text-gray-400">Chưa có món nào ·
            <button onclick="openAddModal('<%= meal.key %>')" class="text-green-500 font-bold hover:underline">Thêm ngay</button>
          </p>
        </div>
      <% } %>
    </div>
    <% }); %>
  </div>

  <!-- ── Gợi ý món ──────────────────────────────────────────── -->
  <% if (suggestions && suggestions.length > 0) { %>
  <div class="nt-card p-5 mb-4" style="background:linear-gradient(135deg,rgba(240,253,244,0.9),rgba(236,253,245,0.9))">
    <div class="flex items-center gap-2 mb-4 flex-wrap">
      <p class="section-title">💡 Gợi ý bữa tiếp theo</p>
      <span class="pill pill-green font-black"><%= (metrics.targetCalories||0) - consumed.calories %> kcal còn lại</span>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <% suggestions.forEach(s => { %>
      <div class="suggestion-card"
           onclick="quickAdd(<%= JSON.stringify({id:s.food.id,name:s.food.name,calories:s.food.calories,unit:s.food.unit,protein:s.food.protein,carbs:s.food.carbs,fat:s.food.fat}).replace(/"/g,'&quot;') %>)">
        <p class="font-black text-sm text-gray-800 truncate"><%= s.food.name %></p>
        <p class="text-xs text-gray-500 mt-0.5"><strong class="text-green-600"><%= s.food.calories %></strong> kcal / <%= s.food.unit %></p>
        <div class="flex gap-1 flex-wrap mt-1.5">
          <span class="pill pill-blue">P:<%= s.food.protein %>g</span>
          <span class="pill pill-amber">C:<%= s.food.carbs %>g</span>
          <span class="pill pill-rose">F:<%= s.food.fat %>g</span>
        </div>
        <p class="text-xs text-green-600 font-bold mt-1.5">Còn sau: <%= s.remainingAfter %> kcal</p>
      </div>
      <% }); %>
    </div>
  </div>
  <% } else if (consumed.calories > 0 && calorieProgress >= 100) { %>
  <div class="nt-card p-4 mb-4 flex items-center gap-3" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-color:#86efac">
    <span class="text-3xl float-icon">🎉</span>
    <div>
      <p class="font-black text-green-700">Xuất sắc! Bạn đã đạt mục tiêu calo hôm nay!</p>
      <p class="text-xs text-green-600 mt-0.5 font-medium">Hãy duy trì thói quen tốt này nhé!</p>
    </div>
  </div>
  <% } %>

</main>

<!-- ═══ Modal Thêm Món ═══════════════════════════════════════════ -->
<dialog id="addFoodModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-lg rounded-2xl p-6">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-gray-400">✕</button>
    </form>
    <h3 class="font-black text-lg text-gray-800 mb-5 flex items-center gap-2">
      <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-sm"
            style="background:linear-gradient(135deg,#16a34a,#059669)">➕</span>
      Thêm Món Ăn
    </h3>

    <!-- Search row -->
    <div class="flex gap-2 mb-3">
      <input type="text" id="searchFoodInput" placeholder="Tìm tên món (cơm, phở, thịt...)"
             class="nt-input flex-1 text-sm" oninput="debounceSearch(this.value)" autocomplete="off">
      <select id="categoryFilter" class="nt-select text-sm w-28"
              onchange="debounceSearch(document.getElementById('searchFoodInput').value)">
        <option value="">Tất cả</option>
        <option value="com">Cơm & Xôi</option>
        <option value="pho_bun">Phở, Bún</option>
        <option value="banh">Bánh</option>
        <option value="rau_cu">Rau củ</option>
        <option value="thit_ca">Thịt & Cá</option>
        <option value="do_uong">Đồ uống</option>
        <option value="trai_cay">Trái cây</option>
        <option value="khac">Khác</option>
      </select>
    </div>

    <!-- Results -->
    <div id="searchResults" class="hidden max-h-48 overflow-y-auto rounded-xl border border-gray-100 mb-3 shadow-sm">
      <div id="searchResultsList"></div>
    </div>

    <!-- Selected Preview -->
    <div id="selectedFoodPreview" class="hidden rounded-xl p-3 mb-3" style="background:#f0fdf4;border:1.5px solid #86efac">
      <p class="font-black text-green-700 text-sm" id="selectedFoodName">–</p>
      <p class="text-xs text-gray-500 mt-0.5" id="selectedFoodMacros">–</p>
    </div>

    <!-- Form -->
    <form id="addFoodForm" class="space-y-3">
      <input type="hidden" id="selectedFoodId">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1">Số lượng</label>
          <input type="number" id="foodAmount" value="1" min="0.1" step="0.1"
                 class="nt-input text-sm" oninput="updateCaloriePreview()">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1">Bữa ăn</label>
          <select id="foodMealType" class="nt-select w-full text-sm">
            <option value="sang">🌅 Bữa sáng</option>
            <option value="trua">☀️ Bữa trưa</option>
            <option value="toi">🌙 Bữa tối</option>
            <option value="phu">🍎 Bữa phụ</option>
          </select>
        </div>
      </div>

      <div id="caloriePreview" class="hidden text-center py-2.5 rounded-xl" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #86efac">
        <p class="text-sm text-gray-600 font-medium">Tổng: <strong class="text-green-600 text-base font-black" id="previewCalories">0</strong> kcal</p>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Ghi chú (tùy chọn)</label>
        <input type="text" id="foodNote" placeholder="Ví dụ: thêm đường, bỏ hành..."
               class="nt-input text-sm">
      </div>

      <div class="flex gap-2 pt-1">
        <button type="button" onclick="document.getElementById('addFoodModal').close()"
                class="flex-1 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:bg-gray-100 transition-all border border-gray-200">Hủy</button>
        <button type="button" onclick="submitAddFood()"
                class="flex-1 py-2.5 rounded-xl text-sm font-black text-white transition-all active:scale-95"
                style="background:linear-gradient(135deg,#16a34a,#059669);box-shadow:0 4px 12px rgba(22,163,74,0.3)">
          ✅ Thêm vào nhật ký
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>đóng</button></form>
</dialog>

<script>
const CURRENT_DATE = '<%= date %>';
let selectedFood = null, searchTimer = null;

function goToToday() {
  const d = new Date();
  const t = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  window.location.href = '/nhat-ky?date=' + t;
}

function openAddModal(mealType) {
  selectedFood = null;
  ['selectedFoodId','searchFoodInput','foodNote'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('foodAmount').value = '1';
  ['searchResults','selectedFoodPreview','caloriePreview'].forEach(id => document.getElementById(id).classList.add('hidden'));
  if (mealType) document.getElementById('foodMealType').value = mealType;
  document.getElementById('addFoodModal').showModal();
  setTimeout(() => document.getElementById('searchFoodInput').focus(), 100);
  searchFood('');
}

function quickAdd(foodData) {
  openAddModal(null);
  setTimeout(() => selectFood(foodData), 150);
}

function debounceSearch(q) {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => searchFood(q), 280);
}

async function searchFood(query) {
  const category = document.getElementById('categoryFilter').value;
  try {
    const res  = await fetch('/nhat-ky/tim-mon?' + new URLSearchParams({q:query,category,limit:15}));
    const data = await res.json();
    renderSearchResults(data.foods || []);
  } catch(e) { console.error(e); }
}

function renderSearchResults(foods) {
  const list = document.getElementById('searchResultsList');
  const wrap = document.getElementById('searchResults');
  if (!foods.length) {
    list.innerHTML = '<p class="text-center text-sm text-gray-400 py-4">Không tìm thấy món phù hợp</p>';
    wrap.classList.remove('hidden'); return;
  }
  list.innerHTML = foods.map(f => {
    const safe = JSON.stringify(f).replace(/</g,'\\u003c').replace(/>/g,'\\u003e');
    return `<button type="button" class="w-full text-left px-4 py-2.5 hover:bg-green-50 transition-colors border-b border-gray-50 last:border-0"
              data-food='${safe.replace(/'/g,"\\u0027")}' onclick="selectFood(JSON.parse(this.dataset.food))">
      <p class="font-bold text-sm text-gray-800">${f.name.replace(/</g,'&lt;')}</p>
      <p class="text-xs text-gray-400">${f.calories} kcal / ${f.unit} · P:${f.protein}g C:${f.carbs}g F:${f.fat}g</p>
    </button>`;
  }).join('');
  wrap.classList.remove('hidden');
}

function selectFood(food) {
  selectedFood = food;
  document.getElementById('selectedFoodId').value = food.id;
  document.getElementById('searchFoodInput').value = food.name;
  document.getElementById('searchResults').classList.add('hidden');
  document.getElementById('selectedFoodName').textContent = food.name;
  document.getElementById('selectedFoodMacros').textContent =
    `${food.calories} kcal / ${food.unit} · Protein: ${food.protein}g · Carbs: ${food.carbs}g · Fat: ${food.fat}g`;
  document.getElementById('selectedFoodPreview').classList.remove('hidden');
  updateCaloriePreview();
  document.getElementById('foodAmount').focus();
}

function updateCaloriePreview() {
  if (!selectedFood) return;
  const kcal = Math.round(selectedFood.calories * (parseFloat(document.getElementById('foodAmount').value)||0));
  document.getElementById('previewCalories').textContent = kcal;
  document.getElementById('caloriePreview').classList.remove('hidden');
}

async function submitAddFood() {
  const foodId   = document.getElementById('selectedFoodId').value;
  const amount   = document.getElementById('foodAmount').value;
  const mealType = document.getElementById('foodMealType').value;
  const note     = document.getElementById('foodNote').value;
  if (!foodId) { showToast('Vui lòng chọn một món ăn.','warning'); return; }
  if (!amount || parseFloat(amount) <= 0) { showToast('Số lượng phải lớn hơn 0.','warning'); return; }
  try {
    showLoading();
    const res  = await fetch('/nhat-ky/them', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({foodId,amount,mealType,date:CURRENT_DATE,note}),
    });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      document.getElementById('addFoodModal').close();
      showToast(data.message,'success');
      setTimeout(() => location.reload(), 700);
    } else { showToast(data.message||'Có lỗi xảy ra.','error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.','error'); }
}

async function deleteEntry(id) {
  if (!confirm('Bạn có chắc muốn xóa mục này không?')) return;
  try {
    showLoading();
    const res  = await fetch(`/nhat-ky/xoa/${id}`, {method:'DELETE'});
    const data = await res.json();
    hideLoading();
    if (data.success) {
      const el = document.getElementById(`entry-${id}`);
      if (el) { el.style.opacity='0'; el.style.transform='translateX(20px)'; el.style.transition='all 0.3s'; setTimeout(()=>{el.remove();location.reload();},350); }
      showToast(data.message,'success');
    } else { showToast(data.message||'Lỗi.','error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.','error'); }
}
</script>

<%- include('../partials/footer') %>
