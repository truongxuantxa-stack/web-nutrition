<div class="navbar bg-base-100 shadow-sm mb-6 px-4 sm:px-8">
  <div class="flex-1">
    <a href="/" class="btn btn-ghost normal-case text-xl text-success font-bold">NutriTrack</a>
  </div>
  <div class="flex-none gap-2">
    <% if (typeof user !== 'undefined' && user) { %>
      <ul class="menu menu-horizontal px-1 hidden sm:flex">
        <li><a href="/dashboard">Tổng quan</a></li>
        <li><a href="/nhat-ky">Nhật ký</a></li>
        <li><a href="/goi-y">Gợi ý</a></li>
        <li><a href="/can-nang">Cân nặng</a></li>
      </ul>
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="btn btn-ghost btn-circle avatar placeholder">
          <div class="bg-neutral-focus text-neutral-content rounded-full w-10">
            <span><%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %></span>
          </div>
        </label>
        <ul tabindex="0" class="mt-3 z-[1] p-2 shadow menu menu-sm dropdown-content bg-base-100 rounded-box w-52">
          <li><a href="/ho-so">Hồ sơ cá nhân</a></li>
          <li><a href="/auth/logout" class="text-error">Đăng xuất</a></li>
        </ul>
      </div>
    <% } else { %>
      <a href="/auth/login" class="btn btn-ghost">Đăng nhập</a>
      <a href="/auth/register" class="btn btn-success text-white">Đăng ký</a>
    <% } %>
  </div>
</div>
