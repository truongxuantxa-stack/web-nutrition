<%
  // Xác định trang active để highlight nav link
  const ap = typeof activePage !== 'undefined' ? activePage : '';
%>

<!-- ═══════════════════════════════════════════════════════════
     Navbar — Desktop sticky glassmorphism
     ═══════════════════════════════════════════════════════════ -->
<nav class="nt-navbar">
  <div class="container mx-auto px-4 max-w-5xl flex items-center justify-between h-14">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 no-underline" style="text-decoration:none">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center"
           style="background:linear-gradient(135deg,#16a34a,#059669)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </div>
      <span class="auth-logo text-xl">NutriTrack</span>
    </a>

    <!-- Desktop Nav Links -->
    <% if (typeof user !== 'undefined' && user) { %>
    <div class="hidden md:flex items-center gap-1">
      <a href="/dashboard" class="nt-nav-link <%= ap==='dashboard' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Tổng quan
      </a>
      <a href="/nhat-ky" class="nt-nav-link <%= ap==='diary' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        Nhật ký
      </a>
      <a href="/can-nang" class="nt-nav-link <%= ap==='weight' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        Cân nặng
      </a>
      <a href="/luyen-tap" class="nt-nav-link <%= ap==='exercise' ? 'active' : '' %>">
        🔥 Luyện tập
      </a>
    </div>

    <!-- Desktop User Menu -->
    <div class="hidden md:flex items-center gap-3">
      <a href="/nhat-ky?date=<%= typeof today !== 'undefined' ? today : new Date().toISOString().split('T')[0] %>"
         class="btn-primary-green text-sm flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Ghi nhật ký
      </a>

      <div class="dropdown dropdown-end">
        <label tabindex="0" class="cursor-pointer flex items-center gap-2 px-3 py-1.5 rounded-xl hover:bg-green-50 transition-all">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold"
               style="background:linear-gradient(135deg,#16a34a,#059669)">
            <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
          </div>
          <span class="text-sm font-medium text-gray-700 max-w-[80px] truncate"><%= user.fullName %></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </label>
        <ul tabindex="0" class="dropdown-content z-50 mt-2 p-2 shadow-xl bg-white rounded-2xl w-48 border border-gray-100">
          <li>
            <a href="/ho-so" class="flex items-center gap-2 px-3 py-2 rounded-xl text-sm text-gray-700 hover:bg-green-50 hover:text-green-700 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Hồ sơ cá nhân
            </a>
          </li>
          <li class="border-t border-gray-100 mt-1 pt-1">
            <a href="/dang-xuat" class="flex items-center gap-2 px-3 py-2 rounded-xl text-sm text-red-500 hover:bg-red-50 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              Đăng xuất
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Mobile: user avatar only -->
    <div class="flex md:hidden items-center gap-2">
      <a href="/ho-so" class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold"
         style="background:linear-gradient(135deg,#16a34a,#059669)">
        <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
      </a>
    </div>

    <% } else { %>
    <!-- Guest nav -->
    <div class="flex items-center gap-2">
      <a href="/dang-nhap" class="nt-nav-link">Đăng nhập</a>
      <a href="/dang-ky" class="btn-primary-green">Đăng ký</a>
    </div>
    <% } %>

  </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════
     Bottom Nav — Mobile only
     ═══════════════════════════════════════════════════════════ -->
<% if (typeof user !== 'undefined' && user) { %>
<nav class="bottom-nav md:hidden">
  <a href="/dashboard" class="bottom-nav-item <%= ap==='dashboard' ? 'active' : '' %>">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
    </svg>
    Tổng quan
  </a>
  <a href="/nhat-ky" class="bottom-nav-item <%= ap==='diary' ? 'active' : '' %>">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
    </svg>
    Nhật ký
  </a>
  <a href="/nhat-ky?date=<%= typeof today !== 'undefined' ? today : '' %>"
     class="bottom-nav-item" style="color:white">
    <div class="w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg -mt-5 mb-1"
         style="background:linear-gradient(135deg,#16a34a,#059669)">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
    </div>
    <span style="color:#16a34a;font-weight:700">Thêm</span>
  </a>
  <a href="/can-nang" class="bottom-nav-item <%= ap==='weight' ? 'active' : '' %>">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
    </svg>
    Cân nặng
  </a>
  <a href="/luyen-tap" class="bottom-nav-item <%= ap==='exercise' ? 'active' : '' %>">
    🔥
    Luyện tập
  </a>
  <a href="/ho-so" class="bottom-nav-item <%= ap==='profile' ? 'active' : '' %>">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>
    Hồ sơ
  </a>
</nav>
<% } %>
