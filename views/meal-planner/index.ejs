<%- include('../partials/header') %>
<%- include('../partials/navbar', { activePage: 'mealplanner' }) %>

<div class="container mx-auto px-4 py-8 pb-24 max-w-6xl">
    <div class="flex items-center gap-4 mb-8">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center shadow-lg"
             style="background:linear-gradient(135deg,#16a34a,#059669)">
             <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
             </svg>
        </div>
        <div>
            <h1 class="text-3xl font-black text-gray-800 tracking-tight">Thuật Toán Bữa Ăn</h1>
            <p class="text-gray-500 font-medium">Gợi ý nguyên liệu Hardcore Tracking chuẩn Macro</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Cột Left: Điều khiển -->
        <div class="lg:col-span-1 space-y-6">
            
            <!-- Cấu hình bữa ăn -->
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-green-50 rounded-full blur-3xl -mr-10 -mt-10"></div>
                <h2 class="text-lg font-bold text-gray-800 mb-4 relative z-10 flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-green-600"></i>
                    Phân Bổ Năng Lượng
                </h2>
                
                <form id="mealConfigForm" class="space-y-4 relative z-10">
                    <div id="mealConfigContainer" class="space-y-3">
                        <!-- Render JS -->
                        <div class="text-center text-sm text-gray-400 py-4"><span class="loading loading-spinner loading-sm"></span> Đang tải...</div>
                    </div>
                    
                    <div class="pt-2 border-t border-gray-100 flex justify-between items-center">
                        <span class="text-sm font-medium text-gray-500">Tổng cộng:</span>
                        <span id="totalPercentDisplay" class="font-bold text-green-600">0%</span>
                    </div>

                    <button type="submit" id="btnSaveConfig" class="w-full py-2.5 rounded-xl text-sm font-semibold text-white transition-all bg-gray-900 hover:bg-gray-800 shadow-md">
                        Lưu cấu hình
                    </button>
                </form>
            </div>

            <!-- Generate Panel -->
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 relative overflow-hidden">
                <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-green-600"></i>
                    Sinh Bữa Ăn
                </h2>

                <div id="allergyBanner" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-3 flex items-center gap-2 text-sm mb-4">
                    <i class="fa-solid fa-shield-halved text-amber-500"></i>
                    <span class="text-amber-700 font-medium" id="allergyBannerText">Đã kích hoạt lọc dị ứng.</span>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Chọn bữa ăn</label>
                        <select id="selectMealKey" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all">
                            <option value="sang">Bữa sáng</option>
                            <option value="trua" selected>Bữa trưa</option>
                            <option value="toi">Bữa tối</option>
                            <option value="phu">Bữa phụ</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Khuôn mẫu Template</label>
                        <select id="selectTemplate" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 transition-all">
                            <option value="">Đang tải...</option>
                        </select>
                    </div>

                    <button id="btnGenerate" class="w-full py-3 mt-2 rounded-xl text-sm font-bold text-white transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5"
                            style="background:linear-gradient(135deg,#16a34a,#059669)">
                        <i class="fa-solid fa-bolt mr-1"></i> TẠO GỢI Ý
                    </button>
                </div>
            </div>

        </div>

        <!-- Cột Right: Hiển thị Kết quả -->
        <div class="lg:col-span-2">
            <div id="resultPanel" class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 min-h-[500px] flex flex-col relative">
                
                <!-- Skeleton Loading -->
                <div id="loadingOverlay" class="absolute inset-0 bg-white/80 backdrop-blur-sm z-20 hidden items-center justify-center rounded-3xl">
                    <div class="flex flex-col items-center gap-3">
                        <span class="loading loading-infinity loading-lg text-green-600"></span>
                        <p class="text-sm font-semibold text-green-700 animate-pulse">Đang giải ma trận Macro...</p>
                    </div>
                </div>

                <!-- Empty State -->
                <div id="emptyState" class="flex-1 flex flex-col items-center justify-center text-center opacity-60">
                    <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                        <i class="fa-solid fa-plate-wheat text-4xl text-gray-400"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-600">Chưa có dữ liệu</h3>
                    <p class="text-sm text-gray-500 max-w-sm mt-1">Vui lòng chọn cấu hình ở cột bên trái và nhấn "Tạo Gợi Ý" để hệ thống tính toán nguyên liệu.</p>
                </div>

                <!-- Error State -->
                <div id="errorState" class="hidden flex-1 flex flex-col items-center justify-center text-center">
                    <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mb-4">
                        <i class="fa-solid fa-triangle-exclamation text-3xl text-red-500"></i>
                    </div>
                    <h3 class="text-lg font-bold text-red-600 mb-1">Không thể giải hệ phương trình</h3>
                    <p id="errorMessage" class="text-sm text-red-500 max-w-md">Lỗi...</p>
                    <button id="btnRetryGenerate" class="mt-4 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-semibold transition-colors">
                        Thử lại
                    </button>
                </div>

                <!-- Result View -->
                <div id="resultView" class="hidden flex-1 flex flex-col">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h2 class="text-xl font-black text-gray-800">Thực Đơn Đề Xuất</h2>
                            <p class="text-sm text-gray-500 mt-1">Đảm bảo độ chính xác tuyệt đối 99% theo Macro.</p>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-black text-green-600" id="resTotalCal">0 kcal</div>
                        </div>
                    </div>

                    <!-- Macro Chart Mini -->
                    <div class="flex gap-2 mb-6">
                        <div class="flex-1 bg-red-50 rounded-xl p-3 border border-red-100">
                            <div class="text-xs font-semibold text-red-500 mb-1">PROTEIN</div>
                            <div class="text-lg font-bold text-red-700" id="resTotalPro">0g</div>
                        </div>
                        <div class="flex-1 bg-blue-50 rounded-xl p-3 border border-blue-100">
                            <div class="text-xs font-semibold text-blue-500 mb-1">CARBS</div>
                            <div class="text-lg font-bold text-blue-700" id="resTotalCarb">0g</div>
                        </div>
                        <div class="flex-1 bg-yellow-50 rounded-xl p-3 border border-yellow-100">
                            <div class="text-xs font-semibold text-yellow-600 mb-1">FAT</div>
                            <div class="text-lg font-bold text-yellow-700" id="resTotalFat">0g</div>
                        </div>
                    </div>

                    <!-- Warnings -->
                    <div id="warningContainer" class="mb-4 space-y-2 hidden">
                        <!-- render js -->
                    </div>

                    <!-- Food List -->
                    <div class="space-y-3" id="foodListContainer">
                        <!-- render js -->
                    </div>

                    <!-- Action Bottom -->
                    <div class="mt-auto pt-6 border-t border-gray-100 flex gap-3">
                        <button class="flex-1 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-bold text-sm transition-colors flex items-center justify-center gap-2" id="btnLogMeal">
                            <i class="fa-solid fa-book-medical"></i> Ghi vào Nhật Ký
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal Đổi Món -->
<dialog id="swapModal" class="modal">
    <div class="modal-box rounded-3xl max-w-md">
        <h3 class="font-bold text-lg mb-4">Đổi Nguyên Liệu</h3>
        <p class="text-sm text-gray-500 mb-4">Chọn nguyên liệu bạn muốn thay thế cho <strong id="swapFoodName" class="text-gray-800">...</strong></p>
        
        <div class="space-y-3 mb-6" id="swapFoodList">
            <div class="text-center py-4"><span class="loading loading-spinner"></span></div>
        </div>

        <div class="modal-action">
            <form method="dialog">
                <button class="btn btn-ghost rounded-xl">Đóng</button>
            </form>
        </div>
    </div>
</dialog>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/meal-planner.js"></script>

<%- include('../partials/footer') %>
