<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container mx-auto px-4 max-w-3xl py-6">

  <!-- ── Page Header ────────────────────────────────────────── -->
  <div class="mb-6">
    <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">👤 Hồ Sơ Cá Nhân</h1>
    <p class="text-sm text-gray-500 mt-0.5 font-medium">Cập nhật thông tin sức khỏe để tính toán dinh dưỡng chính xác hơn.</p>
  </div>

  <!-- ── Alerts ─────────────────────────────────────────────── -->
  <% if (success) { %>
  <div class="flex items-center gap-3 p-4 rounded-2xl mb-5 alert-auto-dismiss"
       style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #86efac">
    <span class="text-xl">✅</span>
    <p class="font-bold text-green-700"><%= success %></p>
  </div>
  <% } %>
  <% if (error) { %>
  <div class="flex items-center gap-3 p-4 rounded-2xl mb-5" style="background:#fff1f2;border:1.5px solid #fca5a5">
    <span class="text-xl">❌</span>
    <p class="font-bold text-red-600"><%= error %></p>
  </div>
  <% } %>

  <!-- ── Profile Card ───────────────────────────────────────── -->
  <div class="nt-card p-6 md:p-8">

    <!-- Avatar banner -->
    <div class="flex items-center gap-4 mb-7 pb-6 border-b border-gray-100">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white text-2xl font-black shadow-lg flex-shrink-0"
           style="background:linear-gradient(135deg,#16a34a,#059669);box-shadow:0 8px 24px rgba(22,163,74,0.3)">
        <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div>
        <p class="text-xl font-black text-gray-800"><%= user.fullName %></p>
        <p class="text-sm text-gray-500 font-medium"><%= user.email %></p>
        <span class="pill pill-green mt-1.5 inline-flex font-bold">✅ Đã xác thực</span>
      </div>
    </div>

    <form action="/ho-so" method="POST" id="profileForm">

      <!-- Thông tin cơ bản -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-black"
               style="background:linear-gradient(135deg,#16a34a,#059669)">1</div>
          <p class="section-title">Thông Tin Cơ Bản</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="fullName">
              Họ và tên <span class="text-red-500">*</span>
            </label>
            <input type="text" id="fullName" name="fullName"
                   class="nt-input" value="<%= user.fullName %>" required>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="gender">Giới tính</label>
            <select id="gender" name="gender" class="nt-select w-full">
              <option value="">-- Chọn --</option>
              <option value="male"   <%= user.gender==='male'   ?'selected':'' %>>👨 Nam</option>
              <option value="female" <%= user.gender==='female' ?'selected':'' %>>👩 Nữ</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="birthDate">Ngày sinh</label>
            <input type="date" id="birthDate" name="birthDate"
                   class="nt-input"
                   value="<%= user.birthDate ? user.birthDate.toString().split('T')[0] : '' %>"
                   max="<%= new Date().toISOString().split('T')[0] %>">
          </div>
        </div>
      </div>

      <div class="border-t border-gray-100 mb-6"></div>

      <!-- Chỉ số thể chất -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-black"
               style="background:linear-gradient(135deg,#3b82f6,#2563eb)">2</div>
          <p class="section-title">📏 Chỉ Số Thể Chất</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="height">Chiều cao</label>
            <div class="relative">
              <input type="number" id="height" name="height"
                     class="nt-input pr-10" placeholder="170"
                     min="50" max="300" step="0.1" value="<%= user.height||'' %>">
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400 font-black">cm</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="weight">Cân nặng</label>
            <div class="relative">
              <input type="number" id="weight" name="weight"
                     class="nt-input pr-10" placeholder="65"
                     min="10" max="500" step="0.1" value="<%= user.weight||'' %>">
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400 font-black">kg</span>
            </div>
          </div>
        </div>

        <!-- BMI preview -->
        <div id="bmiPreview" class="hidden mt-3 p-3.5 rounded-xl text-sm font-semibold transition-all"
             style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #86efac">
          <div class="flex items-center justify-between">
            <span class="text-gray-600 font-medium">BMI ước tính:</span>
            <div class="text-right">
              <span id="bmiValue" class="text-green-700 font-black text-xl"></span>
              <span id="bmiLabel" class="block text-xs text-green-600 font-bold"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-gray-100 mb-6"></div>

      <!-- Mức hoạt động & Mục tiêu -->
      <div class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-black"
               style="background:linear-gradient(135deg,#8b5cf6,#7c3aed)">3</div>
          <p class="section-title">🎯 Mức Hoạt Động & Mục Tiêu</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="activityLevel">Mức hoạt động thể chất</label>
            <select id="activityLevel" name="activityLevel" class="nt-select w-full">
              <option value="">-- Chọn --</option>
              <option value="sedentary"   <%= user.activityLevel==='sedentary'  ?'selected':'' %>>🪑 Ít vận động (×1.2)</option>
              <option value="light"       <%= user.activityLevel==='light'      ?'selected':'' %>>🚶 Vận động nhẹ (×1.375)</option>
              <option value="moderate"    <%= user.activityLevel==='moderate'   ?'selected':'' %>>🏃 Vận động vừa (×1.55)</option>
              <option value="active"      <%= user.activityLevel==='active'     ?'selected':'' %>>🏋️ Vận động nhiều (×1.725)</option>
              <option value="very_active" <%= user.activityLevel==='very_active'?'selected':'' %>>⚡ Rất nhiều (×1.9)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1.5" for="goal">Mục tiêu sức khỏe</label>
            <select id="goal" name="goal" class="nt-select w-full">
              <option value="">-- Chọn --</option>
              <option value="lose_weight"     <%= user.goal==='lose_weight'    ?'selected':'' %>>🔥 Giảm cân</option>
              <option value="maintain_weight" <%= user.goal==='maintain_weight'?'selected':'' %>>⚖️ Duy trì cân nặng</option>
              <option value="gain_weight"     <%= user.goal==='gain_weight'    ?'selected':'' %>>💪 Tăng cơ / Tăng cân</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between gap-3 flex-wrap pt-2 border-t border-gray-100">
        <a href="/dashboard" class="px-4 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:bg-gray-100 border border-gray-200 transition-all flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Quay lại
        </a>
        <button type="submit" id="saveBtn" class="btn-primary-green px-8 py-2.5 text-sm">
          💾 Lưu thay đổi
        </button>
      </div>

    </form>
  </div>

  <!-- ── Custom Macros Planner ─────────────────────────── -->
  <div class="nt-card p-6 md:p-8 mt-5" id="macroPlanner">

    <div class="flex items-center gap-2 mb-1">
      <div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-black"
           style="background:linear-gradient(135deg,#f59e0b,#d97706)">🎯</div>
      <p class="section-title">Tỷ lệ Macro cá nhân</p>
      <% if (user.macroProtein !== null) { %>
      <span class="pill ml-auto" style="background:#fef9c3;color:#854d0e;border:1.5px solid #fde68a;font-size:11px">✏️ Tùy chỉnh</span>
      <% } else { %>
      <span class="pill ml-auto" style="background:#f1f5f9;color:#64748b;border:1.5px solid #e2e8f0;font-size:11px">Mặc định</span>
      <% } %>
    </div>
    <p class="text-xs text-gray-400 font-medium mb-5">
      ℹ️ Mục tiêu macro luôn hiển thị theo thiết lập mới nhất.
    </p>

    <!-- Preset buttons -->
    <div class="flex flex-wrap gap-2 mb-5">
      <span class="text-xs font-bold text-gray-500 self-center">Preset nhanh:</span>
      <button type="button" onclick="applyPreset(30,40,30)" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 hover:border-green-400 hover:bg-green-50 transition-all text-gray-600">🎯 Mặc định</button>
      <button type="button" onclick="applyPreset(40,40,20)" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 hover:border-blue-400 hover:bg-blue-50 transition-all text-gray-600">💪 Tăng cơ</button>
      <button type="button" onclick="applyPreset(40,30,30)" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 hover:border-orange-400 hover:bg-orange-50 transition-all text-gray-600">🔥 Giảm mỡ</button>
      <button type="button" onclick="applyPreset(25,5,70)"  class="px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 hover:border-yellow-400 hover:bg-yellow-50 transition-all text-gray-600">🥑 Keto</button>
      <button type="button" onclick="applyPreset(30,55,15)" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 hover:border-purple-400 hover:bg-purple-50 transition-all text-gray-600">🏃 Low-fat</button>
    </div>

    <!-- Inputs -->
    <div class="space-y-3 mb-4">
      <!-- Protein -->
      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-blue-600 w-16">🥩 Protein</span>
        <button type="button" onclick="adjustMacro('mp',-1)" class="w-8 h-8 rounded-lg font-black text-gray-600 border border-gray-200 hover:bg-gray-100 transition-all flex-shrink-0">−</button>
        <input type="number" id="mp" min="5" max="70" value="<%= user.macroProtein ?? 30 %>" class="nt-input text-center font-black text-blue-700" style="width:72px" oninput="updateSummary()">
        <button type="button" onclick="adjustMacro('mp',1)"  class="w-8 h-8 rounded-lg font-black text-gray-600 border border-gray-200 hover:bg-gray-100 transition-all flex-shrink-0">+</button>
        <span class="text-sm text-gray-400 font-semibold">%</span>
        <% if (!user.macroProtein) { %><span class="text-xs text-gray-400 italic">(mặc định)</span><% } %>
      </div>
      <!-- Carbs -->
      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-amber-600 w-16">🍚 Carbs</span>
        <button type="button" onclick="adjustMacro('mc',-1)" class="w-8 h-8 rounded-lg font-black text-gray-600 border border-gray-200 hover:bg-gray-100 transition-all flex-shrink-0">−</button>
        <input type="number" id="mc" min="5" max="80" value="<%= user.macroCarbs ?? 40 %>" class="nt-input text-center font-black text-amber-700" style="width:72px" oninput="updateSummary()">
        <button type="button" onclick="adjustMacro('mc',1)"  class="w-8 h-8 rounded-lg font-black text-gray-600 border border-gray-200 hover:bg-gray-100 transition-all flex-shrink-0">+</button>
        <span class="text-sm text-gray-400 font-semibold">%</span>
        <% if (!user.macroCarbs) { %><span class="text-xs text-gray-400 italic">(mặc định)</span><% } %>
      </div>
      <!-- Fat -->
      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-rose-600 w-16">🥑 Fat</span>
        <button type="button" onclick="adjustMacro('mf',-1)" class="w-8 h-8 rounded-lg font-black text-gray-600 border border-gray-200 hover:bg-gray-100 transition-all flex-shrink-0">−</button>
        <input type="number" id="mf" min="5" max="70" value="<%= user.macroFat ?? 30 %>" class="nt-input text-center font-black text-rose-700" style="width:72px" oninput="updateSummary()">
        <button type="button" onclick="adjustMacro('mf',1)"  class="w-8 h-8 rounded-lg font-black text-gray-600 border border-gray-200 hover:bg-gray-100 transition-all flex-shrink-0">+</button>
        <span class="text-sm text-gray-400 font-semibold">%</span>
        <% if (!user.macroFat) { %><span class="text-xs text-gray-400 italic">(mặc định)</span><% } %>
      </div>
    </div>

    <!-- Tổng + Preview -->
    <div class="p-3.5 rounded-xl mb-4" id="macroSummaryBox"
         style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #86efac">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <span class="text-sm font-bold text-gray-600">Tổng: <span id="macroTotal" class="text-lg font-black text-green-700">100%</span></span>
        <span class="text-xs text-gray-500 font-medium" id="macroPreview"></span>
      </div>
    </div>

    <!-- Save button -->
    <div class="flex justify-end">
      <button type="button" id="saveMacroBtn" onclick="saveMacros()"
              class="btn-primary-green px-8 py-2.5 text-sm">
        💾 Lưu tỷ lệ
      </button>
    </div>
  </div>

</main>

<script>
const hInput = document.getElementById('height');
const wInput = document.getElementById('weight');
const bmiDiv = document.getElementById('bmiPreview');
const bmiVal = document.getElementById('bmiValue');
const bmiLbl = document.getElementById('bmiLabel');

const bmiCategories = [
  { max: 18.5, label: 'Thiếu cân', color: '#d97706' },
  { max: 25.0, label: 'Bình thường ✅', color: '#16a34a' },
  { max: 30.0, label: 'Thừa cân', color: '#f59e0b' },
  { max: Infinity, label: 'Béo phì', color: '#ef4444' },
];

function updateBMI() {
  const h = parseFloat(hInput.value);
  const w = parseFloat(wInput.value);
  if (h > 50 && w > 10) {
    const bmi = Math.round((w / Math.pow(h/100, 2)) * 10) / 10;
    const cat = bmiCategories.find(c => bmi < c.max);
    bmiVal.textContent = bmi;
    bmiVal.style.color = cat.color;
    bmiLbl.textContent = cat.label;
    bmiLbl.style.color = cat.color;
    bmiDiv.classList.remove('hidden');
  } else {
    bmiDiv.classList.add('hidden');
  }
}
hInput.addEventListener('input', updateBMI);
wInput.addEventListener('input', updateBMI);
updateBMI();

document.getElementById('profileForm').addEventListener('submit', (e) => {
  const h = parseFloat(document.getElementById('height').value);
  const w = parseFloat(document.getElementById('weight').value);

  // [QA-FIX] Client-side guard: chặn giá trị không hợp lệ
  if (document.getElementById('height').value && (isNaN(h) || h < 50 || h > 300)) {
    e.preventDefault();
    showToast('Chiều cao không hợp lệ (50–300 cm).', 'warning');
    return;
  }
  if (document.getElementById('weight').value && (isNaN(w) || w < 10 || w > 500)) {
    e.preventDefault();
    showToast('Cân nặng không hợp lệ (10–500 kg).', 'warning');
    return;
  }

  const btn = document.getElementById('saveBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Đang lưu...';
  showLoading();
});

// ── Custom Macros Logic ──────────────────────────────────────
// targetCalories từ server (null nếu chưa đủ dữ liệu)
const _targetCal = <%= (typeof metrics !== 'undefined' && metrics && metrics.targetCalories) ? metrics.targetCalories : 'null' %>;

function adjustMacro(id, delta) {
  const el = document.getElementById(id);
  const val = parseInt(el.value) || 0;
  el.value = Math.min(parseInt(el.max), Math.max(parseInt(el.min), val + delta));
  updateSummary();
}

function applyPreset(p, c, f) {
  document.getElementById('mp').value = p;
  document.getElementById('mc').value = c;
  document.getElementById('mf').value = f;
  updateSummary();
}

function updateSummary() {
  const p = parseInt(document.getElementById('mp').value) || 0;
  const c = parseInt(document.getElementById('mc').value) || 0;
  const f = parseInt(document.getElementById('mf').value) || 0;
  const total = p + c + f;
  const totalEl = document.getElementById('macroTotal');
  const boxEl   = document.getElementById('macroSummaryBox');
  const saveBtn = document.getElementById('saveMacroBtn');
  const previewEl = document.getElementById('macroPreview');

  totalEl.textContent = total + '%';
  if (total === 100) {
    totalEl.style.color = '#16a34a';
    boxEl.style.borderColor = '#86efac';
    boxEl.style.background = 'linear-gradient(135deg,#f0fdf4,#dcfce7)';
    saveBtn.disabled = false;
    saveBtn.style.opacity = '1';
    // Preview gram
    if (_targetCal) {
      const pg = Math.round((_targetCal * p / 100) / 4);
      const cg = Math.round((_targetCal * c / 100) / 4);
      const fg = Math.round((_targetCal * f / 100) / 9);
      previewEl.textContent = `Preview: Protein ~${pg}g | Carbs ~${cg}g | Fat ~${fg}g`;
    } else {
      previewEl.textContent = '';
    }
  } else {
    totalEl.style.color = '#ef4444';
    boxEl.style.borderColor = '#fca5a5';
    boxEl.style.background = 'linear-gradient(135deg,#fff1f2,#ffe4e6)';
    saveBtn.disabled = true;
    saveBtn.style.opacity = '0.5';
    previewEl.textContent = `Tổng đang là ${total}% — cần đạt đúng 100%`;
  }
}
updateSummary();

async function saveMacros() {
  const p = parseInt(document.getElementById('mp').value);
  const c = parseInt(document.getElementById('mc').value);
  const f = parseInt(document.getElementById('mf').value);
  const btn = document.getElementById('saveMacroBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Đang lưu...';
  try {
    const res = await fetch('/ho-so/macros', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ macroProtein: p, macroCarbs: c, macroFat: f }),
    });
    const data = await res.json();
    if (data.success) {
      showToast(data.message, 'success');
      // Reload để badge Tùy chỉnh/Mặc định cập nhật
      setTimeout(() => location.reload(), 1200);
    } else {
      showToast(data.message, 'error');
      btn.disabled = false;
      btn.textContent = '💾 Lưu tỷ lệ';
    }
  } catch (e) {
    showToast('Lỗi kết nối, vui lòng thử lại.', 'error');
    btn.disabled = false;
    btn.textContent = '💾 Lưu tỷ lệ';
  }
}
</script>

<%- include('../partials/footer') %>
