<%- include('../partials/header', { title: 'Theo Dõi Cân Nặng' }) %>
<%- include('../partials/navbar') %>

<main class="container mx-auto px-4 max-w-5xl py-6">

  <!-- ── Page Header ────────────────────────────────────────── -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">⚖️ Theo Dõi Cân Nặng</h1>
      <p class="text-sm text-gray-500 mt-0.5 font-medium">Ghi lại hành trình sức khỏe của bạn</p>
    </div>
    <button onclick="document.getElementById('addWeightModal').showModal()"
            class="btn-primary-green flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      Ghi hôm nay
    </button>
  </div>

  <!-- ── Alert ──────────────────────────────────────────────── -->
  <% if (success) { %>
  <div class="flex items-center gap-3 p-4 rounded-2xl mb-4 alert-auto-dismiss"
       style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #86efac">
    <span class="text-xl">✅</span>
    <p class="font-bold text-green-700">Đã lưu cân nặng hôm nay thành công!</p>
  </div>
  <% } %>
  <% const errorCode = typeof error !== 'undefined' ? error : null; %>
  <% if (errorCode) { %>
  <% const errMsgs = { missing:'Vui lòng nhập đầy đủ cân nặng và ngày.', invalid_weight:'Cân nặng không hợp lệ (10–500 kg).', future_date:'Không thể ghi cân nặng cho ngày trong tương lai.', server:'Đã có lỗi xảy ra, vui lòng thử lại.' }; %>
  <div class="flex items-center gap-3 p-4 rounded-2xl mb-4" style="background:#fff1f2;border:1.5px solid #fca5a5">
    <span class="text-xl">❌</span>
    <p class="font-bold text-red-600"><%= errMsgs[errorCode]||'Có lỗi xảy ra.' %></p>
  </div>
  <% } %>

  <!-- ── Stat Cards ─────────────────────────────────────────── -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
    <div class="stat-card green">
      <p class="stat-label">Hiện tại</p>
      <p class="stat-value text-green-600 animated-num"><%= currentWeight ? currentWeight : '–' %></p>
      <p class="stat-sub"><%= currentWeight ? 'kg · mới nhất' : 'Chưa có dữ liệu' %></p>
    </div>
    <div class="stat-card <%= bmiClass.color==='green'?'green':bmiClass.color==='blue'?'blue':bmiClass.color==='yellow'?'amber':'rose' %>">
      <p class="stat-label">BMI</p>
      <p class="stat-value animated-num
        <%= bmiClass.color==='green'?'text-green-600':bmiClass.color==='blue'?'text-blue-600':bmiClass.color==='yellow'?'text-amber-600':'text-red-500' %>">
        <%= currentBMI || '–' %>
      </p>
      <p class="stat-sub font-bold
        <%= bmiClass.color==='green'?'text-green-500':bmiClass.color==='blue'?'text-blue-500':bmiClass.color==='yellow'?'text-amber-500':'text-red-400' %>">
        <%= bmiClass.label %>
      </p>
    </div>
    <div class="stat-card <%= trend && trend.direction==='down' ? 'green' : trend && trend.direction==='up' ? 'rose' : 'blue' %>">
      <p class="stat-label">30 ngày</p>
      <% if (trend) { %>
        <p class="stat-value animated-num
          <%= trend.direction==='down'?'text-green-600':trend.direction==='up'?'text-red-500':'text-blue-500' %>">
          <%= trend.direction==='down'?'▼':trend.direction==='up'?'▲':'→' %> <%= Math.abs(trend.diff) %>
        </p>
        <p class="stat-sub"><%= trend.direction==='down'?'kg giảm':trend.direction==='up'?'kg tăng':'Không đổi' %></p>
      <% } else { %>
        <p class="stat-value text-gray-200">–</p>
        <p class="stat-sub">Chưa đủ dữ liệu</p>
      <% } %>
    </div>
    <div class="stat-card amber">
      <p class="stat-label">Mục tiêu</p>
      <p class="text-sm font-black mt-1">
        <% if (user.goal==='lose_weight') { %><span class="text-green-600">📉 Giảm cân</span>
        <% } else if (user.goal==='gain_weight') { %><span class="text-amber-600">📈 Tăng cân</span>
        <% } else { %><span class="text-blue-600">⚖️ Duy trì</span><% } %>
      </p>
      <% if (stats) { %>
      <p class="stat-sub mt-1">TB: <%= stats.avg %> kg</p>
      <% } %>
    </div>
  </div>

  <!-- ── Weight Chart ───────────────────────────────────────── -->
  <% if (logs.length > 1) { %>
  <div class="nt-card p-5 mb-5">
    <p class="section-title mb-4">📈 Biểu đồ cân nặng (90 ngày gần nhất)</p>
    <div class="relative h-60">
      <canvas id="weightChart"></canvas>
    </div>
  </div>
  <% } else { %>
  <div class="nt-card p-8 mb-5 text-center" style="background:linear-gradient(135deg,rgba(240,253,244,0.9),rgba(236,253,245,0.9))">
    <div class="float-icon text-5xl mb-3">📊</div>
    <p class="font-bold text-gray-600 text-lg">Cần ít nhất 2 lần đo để hiển thị biểu đồ</p>
    <p class="text-sm text-gray-400 mt-1 font-medium">Ghi cân nặng mỗi ngày để theo dõi tiến trình!</p>
    <button onclick="document.getElementById('addWeightModal').showModal()"
            class="mt-4 btn-primary-green mx-auto">
      ⚖️ Ghi cân nặng ngay
    </button>
  </div>
  <% } %>

  <!-- ── History Table ──────────────────────────────────────── -->
  <div class="nt-card overflow-hidden">
    <div class="p-4 border-b border-gray-50 flex items-center gap-3">
      <p class="section-title">📋 Lịch sử gần nhất</p>
      <span class="pill pill-green font-black"><%= logs.length %> lần đo</span>
    </div>

    <% if (logs.length === 0) { %>
    <div class="text-center py-12 text-gray-300">
      <div class="float-icon text-5xl mb-3">⚖️</div>
      <p class="font-bold text-gray-400 text-lg">Chưa có dữ liệu cân nặng nào.</p>
      <p class="text-sm text-gray-400 mt-1">Bấm "Ghi hôm nay" để bắt đầu theo dõi!</p>
    </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-50" style="background:rgba(248,250,252,0.8)">
            <th class="text-left px-4 py-3 text-xs font-black text-gray-400 uppercase tracking-widest">Ngày</th>
            <th class="text-right px-4 py-3 text-xs font-black text-gray-400 uppercase tracking-widest">Cân nặng</th>
            <th class="text-right px-4 py-3 text-xs font-black text-gray-400 uppercase tracking-widest">BMI</th>
            <th class="px-4 py-3 text-xs font-black text-gray-400 uppercase tracking-widest">Thay đổi</th>
            <th class="px-4 py-3 text-xs font-black text-gray-400 uppercase tracking-widest">Ghi chú</th>
            <th class="px-2 py-3"></th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach((log, idx) => {
            const bmi  = user.height ? Math.round((log.weight / Math.pow(user.height/100,2))*10)/10 : null;
            const prev = logs[idx+1];
            const diff = prev ? Math.round((log.weight - prev.weight)*10)/10 : null;
          %>
          <tr class="border-b border-gray-50 hover:bg-green-50/30 transition-colors group" id="wlog-<%= log.id %>">
            <td class="px-4 py-3 font-semibold text-gray-700">
              <%= new Date(log.date).toLocaleDateString('vi-VN',{weekday:'short',day:'2-digit',month:'2-digit',year:'numeric'}) %>
            </td>
            <td class="px-4 py-3 text-right font-black text-green-600 text-base"><%= log.weight %> kg</td>
            <td class="px-4 py-3 text-right text-gray-500 font-semibold"><%= bmi || '–' %></td>
            <td class="px-4 py-3">
              <% if (diff !== null) { %>
              <span class="pill <%= diff<0?'pill-green':diff>0?'pill-rose':'pill-blue' %> font-black">
                <%= diff<0?'▼':diff>0?'▲':'→' %> <%= Math.abs(diff) %> kg
              </span>
              <% } else { %><span class="text-xs text-gray-300">–</span><% } %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-400 max-w-[140px] truncate font-medium"><%= log.note || '' %></td>
            <td class="px-2 py-3">
              <button onclick="deleteWeightLog(<%= log.id %>)"
                      class="p-1.5 rounded-lg text-red-400 hover:bg-red-50 hover:text-red-600 transition-all opacity-0 group-hover:opacity-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

</main>

<!-- ── Modal Ghi Cân Nặng ─────────────────────────────────────── -->
<dialog id="addWeightModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-sm rounded-2xl p-6">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-gray-400">✕</button>
    </form>
    <h3 class="font-black text-lg text-gray-800 mb-5 flex items-center gap-2">
      <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white"
            style="background:linear-gradient(135deg,#16a34a,#059669)">⚖️</span>
      Ghi Cân Nặng
    </h3>
    <form action="/can-nang/them" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Ngày đo</label>
        <input type="date" name="date"
               value="<%= todayLocal %>"
               max="<%= todayLocal %>"
               class="nt-input" required>
      </div>
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Cân nặng (kg)</label>
        <input type="number" name="weight" value="<%= currentWeight||'' %>"
               placeholder="Ví dụ: 65.5" min="10" max="500" step="0.1"
               class="nt-input text-2xl font-black" required autofocus>
        <% if (user.height) { %>
        <p class="text-xs text-gray-400 mt-1 font-medium">Chiều cao của bạn: <%= user.height %> cm</p>
        <% } %>
      </div>
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Ghi chú (tùy chọn)</label>
        <input type="text" name="note" placeholder="Ví dụ: sau bữa sáng..." class="nt-input text-sm">
      </div>
      <div class="flex gap-2 pt-1">
        <button type="button" onclick="document.getElementById('addWeightModal').close()"
                class="flex-1 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:bg-gray-100 border border-gray-200 transition-all">Hủy</button>
        <button type="submit" class="flex-1 py-2.5 rounded-xl text-sm font-black text-white transition-all active:scale-95"
                style="background:linear-gradient(135deg,#16a34a,#059669);box-shadow:0 4px 12px rgba(22,163,74,0.3)">💾 Lưu lại</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>đóng</button></form>
</dialog>

<script>
<% if (logs.length > 1) { %>
const chartRawData = <%- chartData %>;
const ctx = document.getElementById('weightChart').getContext('2d');
new Chart(ctx, {
  type: 'line',
  data: {
    labels: chartRawData.map(d => new Date(d.date).toLocaleDateString('vi-VN',{day:'2-digit',month:'2-digit'})),
    datasets: [{
      label: 'Cân nặng (kg)',
      data: chartRawData.map(d => d.weight),
      borderColor: '#16a34a',
      backgroundColor: (ctx) => {
        const g = ctx.chart.ctx.createLinearGradient(0,0,0,ctx.chart.height);
        g.addColorStop(0,'rgba(22,163,74,0.18)');
        g.addColorStop(1,'rgba(22,163,74,0)');
        return g;
      },
      borderWidth: 2.5,
      pointBackgroundColor: '#16a34a',
      pointBorderColor: 'white', pointBorderWidth: 2.5,
      pointRadius: 4.5, pointHoverRadius: 7,
      fill: true, tension: 0.4,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    animation: { duration: 1200, easing: 'easeOutQuart' },
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: 'rgba(15,23,42,0.9)',
        padding: 10, cornerRadius: 10,
        callbacks: { label: c => ` ${c.parsed.y} kg` }
      }
    },
    scales: {
      y: {
        grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
        ticks: { callback: v => v+' kg', font: { size: 11, weight: '600' }, color: '#94a3b8' }
      },
      x: {
        grid: { display: false },
        ticks: { font: { size: 11, weight: '600' }, color: '#94a3b8' }
      }
    }
  }
});
<% } %>

async function deleteWeightLog(id) {
  if (!confirm('Bạn có chắc muốn xóa bản ghi này không?')) return;
  try {
    showLoading();
    const res  = await fetch(`/can-nang/xoa/${id}`, {method:'DELETE'});
    const data = await res.json();
    hideLoading();
    if (data.success) {
      const el = document.getElementById(`wlog-${id}`);
      if (el) { el.style.opacity='0'; el.style.transform='translateX(20px)'; el.style.transition='all 0.3s'; setTimeout(()=>{el.remove();location.reload();},350); }
    } else { showToast(data.message||'Lỗi.','error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.','error'); }
}
</script>

<%- include('../partials/footer') %>
