<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container mx-auto px-4 max-w-5xl py-6">
  <%
    const safeCalorieProgress = isNaN(calorieProgress) ? 0 : Math.max(0, calorieProgress);
  %>
  <!-- ── Welcome Hero Banner ──────────────────────────────── -->
  <div class="hero-banner mb-6">
    <div class="relative z-10 flex items-center justify-between flex-wrap gap-3">
      <div>
        <p class="text-green-200 text-xs font-bold uppercase tracking-widest mb-1.5 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <%= new Date().toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' }) %>
        </p>
        <h1 class="text-2xl md:text-3xl font-black text-white mb-1">Xin chào, <%= user.fullName.split(' ').pop() %> 👋</h1>
        <p class="text-green-100 text-sm font-medium">
          <% if (calorieProgress < 30) { %>🌅 Hãy bắt đầu ngày mới với một bữa ăn lành mạnh!
          <% } else if (calorieProgress < 70) { %>💪 Bạn đang đi đúng hướng, tiếp tục cố gắng nhé!
          <% } else if (calorieProgress < 100) { %>🎯 Gần đến mục tiêu rồi! Cố lên!
          <% } else { %>🎉 Xuất sắc! Bạn đã hoàn thành mục tiêu calo hôm nay!
          <% } %>
        </p>
      </div>
      <div class="flex gap-2 flex-wrap">
        <a href="/nhat-ky?date=<%= today %>"
           class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-bold transition-all"
           style="background:rgba(255,255,255,0.22);color:white;border:1.5px solid rgba(255,255,255,0.35);backdrop-filter:blur(8px)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          Ghi nhật ký
        </a>
        <a href="/can-nang"
           class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all"
           style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.9);border:1.5px solid rgba(255,255,255,0.2)">
          ⚖️ Cân nặng
        </a>
        <!-- ── Dropdown Tải Báo Cáo PDF ── -->
        <div id="pdfDropdownWrapper">
          <button id="pdfDropdownBtn"
                  class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all"
                  style="background:rgba(16,185,129,0.25);color:white;border:1.5px solid rgba(16,185,129,0.5);backdrop-filter:blur(8px)">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            </svg>
            Báo cáo PDF
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
        </div>
        <!-- Menu dùng fixed để thoát khỏi overflow:hidden của hero-banner -->
        <div id="pdfDropdownMenu"
             class="hidden rounded-xl shadow-xl z-[9999] overflow-hidden"
             style="position:fixed;background:white;border:1px solid #d1fae5;width:192px">
          <a href="/api/report/pdf?range=week"
             id="pdfWeekBtn"
             class="flex items-center gap-2 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-green-50 hover:text-green-700 transition-colors border-b border-gray-100">
            <span class="text-base">📊</span>
            Báo cáo 7 ngày
          </a>
          <a href="/api/report/pdf?range=month"
             id="pdfMonthBtn"
             class="flex items-center gap-2 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-green-50 hover:text-green-700 transition-colors">
            <span class="text-base">📈</span>
            Báo cáo 30 ngày
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 4 Stat Cards ──────────────────────────────────────── -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">

    <!-- BMI -->
    <div class="stat-card <%= metrics.bmiClass ? (metrics.bmiClass.color === 'green' ? 'green' : metrics.bmiClass.color === 'blue' ? 'blue' : metrics.bmiClass.color === 'yellow' ? 'amber' : 'rose') : 'green' %>">
      <p class="stat-label">BMI</p>
      <% if (metrics.bmi) { %>
        <p class="stat-value animated-num <%= metrics.bmiClass.color === 'green' ? 'text-green-600' : metrics.bmiClass.color === 'blue' ? 'text-blue-600' : metrics.bmiClass.color === 'yellow' ? 'text-amber-600' : 'text-red-500' %>">
          <%= metrics.bmi %>
        </p>
        <p class="stat-sub font-semibold <%= metrics.bmiClass.color === 'green' ? 'text-green-500' : metrics.bmiClass.color === 'blue' ? 'text-blue-500' : metrics.bmiClass.color === 'yellow' ? 'text-amber-500' : 'text-red-400' %>">
          <%= metrics.bmiClass.label %>
        </p>
      <% } else { %>
        <p class="stat-value text-gray-200">–</p>
        <p class="stat-sub">Chưa có dữ liệu</p>
      <% } %>
    </div>

    <!-- BMR -->
    <div class="stat-card blue">
      <p class="stat-label">BMR</p>
      <p class="stat-value text-blue-600 animated-num"><%= metrics.bmr || '–' %></p>
      <p class="stat-sub">kcal / ngày nghỉ</p>
    </div>

    <!-- TDEE -->
    <div class="stat-card purple relative">
      <p class="stat-label flex items-center justify-between">
        <span>TDEE</span>
        <% if (metrics.isAdaptiveActive) { %>
          <span class="text-[10px] font-bold bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded cursor-help flex items-center gap-0.5 border border-purple-200" title="Dựa trên dữ liệu ăn uống và cân nặng 4 tuần qua, cơ thể bạn đang tiêu hao mức calo khác dự kiến. Chúng tôi đã điều chỉnh tự động để giúp bạn tiếp tục đạt mục tiêu.">Thích ứng ⚡</span>
        <% } else { %>
          <span class="text-[10px] font-bold bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded border border-gray-200">Tĩnh</span>
        <% } %>
      </p>
      <p class="stat-value text-purple-600 animated-num"><%= metrics.tdee || '–' %></p>
      <p class="stat-sub text-xs">
        <% if (metrics.isAdaptiveActive && metrics.staticTDEE) { %>
          <span class="line-through text-gray-400 mr-1"><%= metrics.staticTDEE %></span>
          <span class="<%= metrics.tdee < metrics.staticTDEE ? 'text-red-500' : 'text-green-500' %> font-bold">
            <%= metrics.tdee < metrics.staticTDEE ? 'giảm' : 'tăng' %> <%= Math.abs(metrics.staticTDEE - metrics.tdee) %> kcal
          </span>
        <% } else { %>
          kcal / ngày vận động
        <% } %>
      </p>
    </div>

    <!-- Mục tiêu -->
    <div class="stat-card green">
      <p class="stat-label">Mục tiêu hôm nay</p>
      <p class="stat-value text-green-600 animated-num"><%= effectiveTarget || metrics.targetCalories || '–' %></p>
      <p class="stat-sub">
        <% if (user.goal === 'lose_weight') { %>📉 Giảm cân
        <% } else if (user.goal === 'gain_weight') { %>📈 Tăng cân
        <% } else { %>⚖️ Duy trì<% } %>
      </p>
    </div>
  </div>

  <!-- ── Row 1: Calo + Macros Doughnut ─────────────────────── -->
  <div class="grid md:grid-cols-2 gap-4 mb-4">

    <!-- Calo Card -->
    <div class="nt-card p-5">
      <div class="flex items-center justify-between mb-4">
        <p class="section-title">🔥 Calo hôm nay</p>
        <a href="/nhat-ky?date=<%= today %>" class="text-xs font-bold text-green-600 hover:text-green-700 flex items-center gap-1 transition-colors">
          Xem nhật ký
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Ring + Numbers -->
      <div class="flex items-center gap-5 mb-5">
        <!-- SVG Ring -->
        <div class="relative flex-shrink-0 w-28 h-28">
          <svg class="w-28 h-28 progress-ring" style="transform:rotate(-90deg)" viewBox="0 0 36 36">
            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none" stroke="#f1f5f9" stroke-width="3.5"/>
            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                  fill="none"
                  stroke="<%= safeCalorieProgress >= 100 ? '#ef4444' : '#16a34a' %>"
                  stroke-width="3.5"
                  stroke-dasharray="<%= Math.min(safeCalorieProgress, 100) %>, 100"
                  stroke-linecap="round"
                  style="filter:drop-shadow(0 0 4px rgba(22,163,74,0.4))"/>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="text-xl font-black <%= safeCalorieProgress >= 100 ? 'text-red-500' : 'text-green-600' %>">
              <%= safeCalorieProgress %>%
            </span>
            <span class="text-xs text-gray-400 font-semibold">hôm nay</span>
          </div>
        </div>

        <!-- Stats list -->
        <div class="flex-1 space-y-2.5">
          <% const rem = (effectiveTarget || metrics.targetCalories || 0) - consumed.calories; %>
          <div class="flex justify-between items-center py-1 border-b border-gray-50">
            <span class="text-xs text-gray-500 font-medium">Đã nạp</span>
            <span class="text-sm font-black text-green-600"><%= consumed.calories %> kcal</span>
          </div>
          <% if (totalBurned > 0) { %>
          <div class="flex justify-between items-center py-1 border-b border-gray-50">
            <span class="text-xs text-gray-500 font-medium">🔥 Đã đốt</span>
            <span class="text-sm font-black text-orange-500"><%= totalBurned %> kcal</span>
          </div>
          <% } %>
          <div class="flex justify-between items-center py-1 border-b border-gray-50">
            <span class="text-xs text-gray-500 font-medium">Mục tiêu</span>
            <span class="text-sm font-bold text-gray-700"><%= effectiveTarget || metrics.targetCalories || '–' %> kcal</span>
          </div>
          <div class="flex justify-between items-center py-1 border-b border-gray-50">
            <span class="text-xs text-gray-500 font-medium">Còn lại</span>
            <span class="text-sm font-black <%= rem < 0 ? 'text-red-500' : 'text-amber-500' %>">
              <%= rem >= 0 ? rem : 0 %> kcal
            </span>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-xs text-gray-500 font-medium">Số món</span>
            <span class="text-sm font-bold text-gray-600"><%= mealCount %> món</span>
          </div>
        </div>
      </div>

      <!-- Macro bars -->
      <% if (metrics.macros && metrics.targetCalories) { %>
      <div class="space-y-3 pt-1 border-t border-gray-50">
        <div>
          <div class="flex justify-between text-xs mb-1.5">
            <span class="font-bold text-blue-600">🥩 Protein</span>
            <span class="text-gray-400 font-semibold"><%= consumed.protein %>/<%= metrics.macros.protein %>g</span>
          </div>
          <div class="macro-bar-track">
            <div class="macro-bar-fill bg-blue-500" style="width:<%= macroProgress.protein %>%"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between text-xs mb-1.5">
            <span class="font-bold text-amber-600">🍚 Carbs</span>
            <span class="text-gray-400 font-semibold"><%= consumed.carbs %>/<%= metrics.macros.carbs %>g</span>
          </div>
          <div class="macro-bar-track">
            <div class="macro-bar-fill bg-amber-400" style="width:<%= macroProgress.carbs %>%"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between text-xs mb-1.5">
            <span class="font-bold text-rose-600">🥑 Fat</span>
            <span class="text-gray-400 font-semibold"><%= consumed.fat %>/<%= metrics.macros.fat %>g</span>
          </div>
          <div class="macro-bar-track">
            <div class="macro-bar-fill bg-rose-400" style="width:<%= macroProgress.fat %>%"></div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Doughnut Macros -->
    <div class="nt-card p-5">
      <div class="flex items-center justify-between mb-4">
        <p class="section-title">🍽️ Phân bổ Macros mục tiêu</p>
        <span class="text-xs text-gray-400 font-medium flex items-center gap-1 cursor-help"
              title="Mục tiêu macro luôn hiển thị theo thiết lập mới nhất của bạn.">
          ℹ️
        </span>
      </div>
      <% if (metrics.macros && metrics.targetCalories) { %>
        <div class="relative h-44">
          <canvas id="macroChart"></canvas>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4">
          <div class="rounded-xl py-2.5 px-2 text-center" style="background:linear-gradient(135deg,#eff6ff,#dbeafe)">
            <p class="text-xs font-bold text-blue-600 mb-0.5">Protein</p>
            <p class="font-black text-blue-700 text-base"><%= metrics.macros.protein %>g</p>
            <p class="text-xs text-blue-400 font-semibold"><%= metrics.macroRatios.protein %>%</p>
          </div>
          <div class="rounded-xl py-2.5 px-2 text-center" style="background:linear-gradient(135deg,#fffbeb,#fef3c7)">
            <p class="text-xs font-bold text-amber-600 mb-0.5">Carbs</p>
            <p class="font-black text-amber-700 text-base"><%= metrics.macros.carbs %>g</p>
            <p class="text-xs text-amber-400 font-semibold"><%= metrics.macroRatios.carbs %>%</p>
          </div>
          <div class="rounded-xl py-2.5 px-2 text-center" style="background:linear-gradient(135deg,#fff1f2,#ffe4e6)">
            <p class="text-xs font-bold text-rose-600 mb-0.5">Fat</p>
            <p class="font-black text-rose-700 text-base"><%= metrics.macros.fat %>g</p>
            <p class="text-xs text-rose-400 font-semibold"><%= metrics.macroRatios.fat %>%</p>
          </div>
        </div>
        <!-- Badge trạng thái macro -->
        <div class="flex justify-center mt-3">
          <a href="/ho-so#macroPlanner" class="flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full transition-all hover:opacity-80"
             <% if (metrics.macroRatios.isCustom) { %>
             style="background:#fef9c3;color:#854d0e;border:1px solid #fde68a"
             <% } else { %>
             style="background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0"
             <% } %>>
            <% if (metrics.macroRatios.isCustom) { %>✏️ Tùy chỉnh<% } else { %>🔒 Mặc định<% } %>
            — Chỉnh sửa →
          </a>
        </div>
      <% } else { %>
        <div class="flex flex-col items-center justify-center h-44 text-gray-300">
          <div class="float-icon text-5xl mb-3">📊</div>
          <p class="text-sm text-center text-gray-400">Cập nhật hồ sơ để xem biểu đồ</p>
          <a href="/ho-so" class="mt-3 btn-primary-green text-xs px-4 py-2">Cập nhật ngay →</a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ── Weight Chart ───────────────────────────────────────── -->
  <%
    // [QA-FIX] Parse một lần duy nhất, dùng chung cho HTML và JS chart
    // Tránh parse 2 lần gây double error nếu JSON bị malformed
    let wData = [];
    try { wData = JSON.parse(weightChartData); } catch(e) { wData = []; }
  %>
  <div class="nt-card p-5 mb-4">
    <div class="flex items-center justify-between mb-4">
      <p class="section-title">📈 Cân nặng gần đây</p>
      <a href="/can-nang" class="text-xs font-bold text-green-600 hover:text-green-700 flex items-center gap-1 transition-colors">
        Xem chi tiết
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
    <% if (wData.length >= 2) { %>
      <div class="relative h-40">
        <canvas id="weightMiniChart"></canvas>
      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center py-8 text-gray-300">
        <div class="float-icon text-4xl mb-2">⚖️</div>
        <p class="text-sm text-gray-400">Chưa đủ dữ liệu để vẽ biểu đồ.</p>
        <a href="/can-nang" class="mt-2 text-xs font-bold text-green-600 hover:underline">Ghi cân nặng ngay →</a>
      </div>
    <% } %>
  </div>

  <!-- ── Quick Access Bento ─────────────────────────────────── -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
    <a href="/nhat-ky?date=<%= today %>"
       class="nt-card p-4 text-center cursor-pointer block card-hover"
       style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-color:#86efac">
      <p class="text-2xl mb-1.5 float-icon" style="animation-delay:0s">📔</p>
      <p class="font-black text-sm text-green-700">Nhật ký ăn</p>
      <p class="text-xs text-green-500 mt-0.5 font-semibold">Thêm món ăn</p>
    </a>
    <a href="/can-nang"
       class="nt-card p-4 text-center cursor-pointer block card-hover"
       style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border-color:#93c5fd">
      <p class="text-2xl mb-1.5 float-icon" style="animation-delay:0.3s">⚖️</p>
      <p class="font-black text-sm text-blue-700">Cân nặng</p>
      <p class="text-xs text-blue-500 mt-0.5 font-semibold">Ghi lại hôm nay</p>
    </a>
    <a href="/ho-so"
       class="nt-card p-4 text-center cursor-pointer block card-hover"
       style="background:linear-gradient(135deg,#faf5ff,#ede9fe);border-color:#c4b5fd">
      <p class="text-2xl mb-1.5 float-icon" style="animation-delay:0.6s">👤</p>
      <p class="font-black text-sm text-purple-700">Hồ sơ</p>
      <p class="text-xs text-purple-500 mt-0.5 font-semibold">Cập nhật thông tin</p>
    </a>
    <a href="/nhat-ky?date=<%= today %>#waterCard"
       class="nt-card p-4 text-center cursor-pointer block card-hover"
       style="background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border-color:#7dd3fc">
      <p class="text-2xl mb-1.5 float-icon" style="animation-delay:0.9s">💧</p>
      <p class="font-black text-sm text-sky-700">Nước uống</p>
      <% const _dwPct = waterGoal > 0 ? Math.min(100, Math.round(waterTotal / waterGoal * 100)) : 0; %>
      <p class="text-xs text-sky-500 mt-0.5 font-semibold"><%= waterTotal %>/<%= waterGoal || '?' %> ml</p>
      <div class="mt-1.5 h-1.5 rounded-full bg-sky-100 overflow-hidden">
        <div class="h-full rounded-full transition-all"
             style="width:<%= _dwPct %>%;background:<%= _dwPct >= 100 ? '#16a34a' : '#0ea5e9' %>"></div>
      </div>
    </a>
  </div>

</main>

<!-- ── Charts ──────────────────────────────────────────────────── -->
<script>
<% if (metrics.macros && metrics.targetCalories) { %>
const macroCtx = document.getElementById('macroChart').getContext('2d');
new Chart(macroCtx, {
  type: 'doughnut',
  data: {
    labels: ['Protein', 'Carbs', 'Fat'],
    datasets: [{
      data: [<%= metrics.macros.protein %>, <%= metrics.macros.carbs %>, <%= metrics.macros.fat %>],
      backgroundColor: ['#3b82f6','#f59e0b','#f43f5e'],
      borderColor: ['rgba(255,255,255,0.9)'],
      borderWidth: 5,
      hoverOffset: 10,
      hoverBorderWidth: 3,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    cutout: '72%',
    animation: { animateRotate: true, animateScale: true, duration: 900, easing: 'easeOutQuart' },
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: 'rgba(15,23,42,0.9)',
        padding: 10,
        cornerRadius: 10,
        callbacks: { label: c => ` ${c.label}: ${c.parsed}g` }
      }
    }
  }
});
<% } %>

<%
  // [QA-FIX] wData đã được parse ở trên (try/catch), dùng lại trực tiếp
  // KHÔNG parse lại lần 2 để tránh lỗi nếu JSON malformed
%>
<% if (wData.length >= 2) { %>
const wCtx = document.getElementById('weightMiniChart').getContext('2d');
new Chart(wCtx, {
  type: 'line',
  data: {
    labels: <%- JSON.stringify(wData.map(d => {
      const dt = new Date(d.date);
      return String(dt.getDate()).padStart(2,'0') + '/' + String(dt.getMonth()+1).padStart(2,'0');
    })) %>,
    datasets: [{
      data: <%- JSON.stringify(wData.map(d => d.weight)) %>,
      borderColor: '#16a34a',
      backgroundColor: (ctx) => {
        const g = ctx.chart.ctx.createLinearGradient(0,0,0,ctx.chart.height);
        g.addColorStop(0,'rgba(22,163,74,0.15)');
        g.addColorStop(1,'rgba(22,163,74,0)');
        return g;
      },
      borderWidth: 2.5,
      pointRadius: 4, pointBackgroundColor: '#16a34a',
      pointBorderColor: 'white', pointBorderWidth: 2,
      pointHoverRadius: 6,
      fill: true, tension: 0.4,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    animation: { duration: 1000, easing: 'easeOutQuart' },
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: 'rgba(15,23,42,0.9)',
        padding: 10, cornerRadius: 10,
        callbacks: { label: c => ` ${c.parsed.y} kg` }
      }
    },
    scales: {
      y: {
        grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
        ticks: { callback: v => v+' kg', font: { size: 10, weight: '600' }, color: '#94a3b8' }
      },
      x: {
        grid: { display: false },
        ticks: { font: { size: 10, weight: '600' }, color: '#94a3b8' }
      }
    }
  }
});
<% } %>
</script>

<!-- Script lấy thông báo Adaptive TDEE lần đầu và Lịch sử -->
<script>
document.addEventListener('DOMContentLoaded', async () => {
    try {
        const res = await fetch('/api/adaptive-tdee/status');
        const json = await res.json();
        
        if (json.success && json.data.isAdaptiveActive && json.data.latestLog) {
            const log = json.data.latestLog;
            // Kiểm tra xem log này có mới được tạo trong 2 ngày gần đây không
            const logDate = new Date(log.weekStartDate);
            const today = new Date();
            const diffTime = Math.abs(today - logDate);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            // Dùng localStorage để chỉ hiển thị toast 1 lần
            const toastKey = `adaptive_toast_shown_${log.weekStartDate}`;
            
            if (diffDays <= 3 && !localStorage.getItem(toastKey)) {
                // Hiển thị Toast
                const toast = document.createElement('div');
                toast.className = 'fixed bottom-4 right-4 bg-purple-600 text-white px-5 py-3 rounded-xl shadow-lg z-50 flex items-start gap-3 max-w-sm transform transition-all translate-y-20 opacity-0';
                toast.innerHTML = `
                    <div class="text-2xl mt-0.5">🎉</div>
                    <div>
                        <h4 class="font-bold text-sm mb-1">Tối ưu hóa thông minh!</h4>
                        <p class="text-xs text-purple-100">Hệ thống đã tự động tối ưu lượng calo dựa trên dữ liệu thực tế tuần qua của bạn.</p>
                    </div>
                    <button class="text-purple-300 hover:text-white" onclick="this.parentElement.remove()">✕</button>
                `;
                document.body.appendChild(toast);
                
                // Animate in
                setTimeout(() => {
                    toast.classList.remove('translate-y-20', 'opacity-0');
                }, 500);
                
                // Animate out sau 7s
                setTimeout(() => {
                    toast.classList.add('translate-y-20', 'opacity-0');
                    setTimeout(() => toast.remove(), 500);
                }, 7000);
                
                localStorage.setItem(toastKey, 'true');
            }
        }
    } catch (err) {
        console.error('Lỗi khi fetch TDEE status:', err);
    }
});
</script>

<!-- Script PDF Dropdown (fixed positioning để thoát overflow:hidden) -->
<script>
(function () {
    const btn     = document.getElementById('pdfDropdownBtn');
    const menu    = document.getElementById('pdfDropdownMenu');
    const wrapper = document.getElementById('pdfDropdownWrapper');

    function openMenu() {
        const rect = btn.getBoundingClientRect();
        // Căn phải theo button, ngay dưới button
        menu.style.top  = (rect.bottom + 6) + 'px';
        menu.style.left = (rect.right - 192) + 'px'; // 192 = width menu
        menu.classList.remove('hidden');
    }

    function closeMenu() {
        menu.classList.add('hidden');
    }

    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.contains('hidden') ? openMenu() : closeMenu();
    });

    // Đóng khi click ra ngoài
    document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target) && !menu.contains(e.target)) {
            closeMenu();
        }
    });

    // Cập nhật vị trí khi scroll / resize
    window.addEventListener('scroll', () => { if (!menu.classList.contains('hidden')) openMenu(); }, true);
    window.addEventListener('resize', () => { if (!menu.classList.contains('hidden')) openMenu(); });
})();
</script>

