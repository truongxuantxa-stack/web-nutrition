<%- include('../partials/header', { title: 'Nhật Ký Ăn Uống' }) %>
<%- include('../partials/navbar') %>
<%
  // ── Dynamic date label ────────────────────────────────────────────────────
  const _todayStr = (() => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  })();
  const _isToday   = date === _todayStr;
  const _dateParts = date.split('-'); // [YYYY, MM, DD]
  const _dateLabel = _isToday ? 'hôm nay' : `ngày ${_dateParts[2]}/${_dateParts[1]}`;
  // Prev / Next dates
  const _currDate  = new Date(`${date}T00:00:00`);
  const _prevDate  = new Date(_currDate); _prevDate.setDate(_currDate.getDate() - 1);
  const _nextDate  = new Date(_currDate); _nextDate.setDate(_currDate.getDate() + 1);
  const _fmt = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  const _prevStr   = _fmt(_prevDate);
  const _nextStr   = _fmt(_nextDate);
  const _canGoNext = _nextStr <= _todayStr;
%>

<main class="container mx-auto px-4 max-w-5xl py-6">

  <!-- ── Page Header ────────────────────────────────────────── -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">
        📔 Nhật Ký Ăn Uống
      </h1>
      <p class="text-sm text-gray-500 mt-0.5 font-medium">Theo dõi từng bữa ăn trong ngày</p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Phím tắt: Món của tôi -->
      <a href="/nhat-ky/mon-cua-toi"
         class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-bold text-violet-600 hover:bg-violet-50 transition-all border-2 border-violet-200 hover:border-violet-400">
        🔧 Món của tôi
      </a>
      <!-- Date Navigator -->
      <div class="flex items-center gap-1.5" id="dateNavigator">
        <!-- Prev -->
        <a href="/nhat-ky?date=<%= _prevStr %>"
           class="w-9 h-9 flex items-center justify-center rounded-xl border-2 border-gray-200 text-gray-500 hover:border-green-400 hover:text-green-600 hover:bg-green-50 transition-all font-bold text-base"
           title="Ngày trước">
          ‹
        </a>
        <!-- Date input — nhập tự do, nhấn Enter hoặc nút → để chuyển -->
        <form method="GET" action="/nhat-ky" id="dateNavForm" class="flex items-center gap-1">
          <input type="date" name="date" id="dateInput" value="<%= date %>"
                 max="<%= _todayStr %>"
                 class="nt-input !w-auto text-sm font-semibold px-3"
                 onkeydown="if(event.key==='Enter'){this.form.submit()}">
          <button type="submit"
                  class="w-8 h-8 flex items-center justify-center rounded-xl border-2 border-gray-200 text-gray-500 hover:border-green-400 hover:text-green-600 hover:bg-green-50 transition-all text-base font-bold"
                  title="Chuyển đến ngày này">→</button>
        </form>
        <!-- Next -->
        <% if (_canGoNext) { %>
        <a href="/nhat-ky?date=<%= _nextStr %>"
           class="w-9 h-9 flex items-center justify-center rounded-xl border-2 border-gray-200 text-gray-500 hover:border-green-400 hover:text-green-600 hover:bg-green-50 transition-all font-bold text-base"
           title="Ngày sau">
          ›
        </a>
        <% } else { %>
        <span class="w-9 h-9 flex items-center justify-center rounded-xl border-2 border-gray-100 text-gray-300 cursor-not-allowed font-bold text-base" title="Không thể xem tương lai">›</span>
        <% } %>
        <!-- Hôm nay (ẩn nếu đang xem hôm nay) -->
        <% if (!_isToday) { %>
        <a href="/nhat-ky?date=<%= _todayStr %>"
           class="px-3 py-2 rounded-xl text-sm font-bold text-green-600 hover:bg-green-50 transition-all border-2 border-green-200 hover:border-green-400 whitespace-nowrap">
          Hôm nay
        </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ── Stat Cards ─────────────────────────────────────────── -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
    <div class="stat-card green">
      <p class="stat-label">Đã nạp</p>
      <p class="stat-value text-green-600 animated-num" id="statConsumed"><%= consumed.calories %></p>
      <p class="stat-sub">kcal</p>
    </div>
    <div class="stat-card blue">
      <p class="stat-label flex items-center justify-between">
        <span>Mục tiêu</span>
        <% if (metrics.isAdaptiveActive) { %>
          <span class="text-[10px] font-bold bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded border border-blue-200" title="Mục tiêu calo đã được tự động tối ưu bằng thuật toán TDEE Thích ứng">Thích ứng ⚡</span>
        <% } %>
      </p>
      <p class="stat-value text-blue-600 animated-num"><%= effectiveTarget || metrics.targetCalories || '–' %></p>
      <p class="stat-sub">
        kcal / ngày<% if (totalBurned > 0) { %>
        <span class="text-orange-500 font-bold"> (Đã đốt <%= totalBurned %> kcal)</span>
        <% } %>
      </p>
    </div>
    <div class="stat-card amber">
      <p class="stat-label">Còn lại</p>
      <% const remaining = (effectiveTarget || metrics.targetCalories || 0) - consumed.calories; %>
      <p class="stat-value text-amber-600 animated-num" id="statRemaining">
        <%= remaining >= 0 ? remaining : 0 %>
      </p>
      <p class="stat-sub">kcal</p>
    </div>
    <div class="stat-card green" id="statProgressCard">
      <p class="stat-label">Tiến độ</p>
      <p class="stat-value text-green-600 animated-num" id="statProgress"><%= calorieProgress %>%</p>
      <div class="macro-bar-track mt-1.5">
        <div class="macro-bar-fill bg-green-500" id="statProgressBar"
             style="width:<%= Math.min(calorieProgress,100) %>%"></div>
      </div>
    </div>
  </div>

  <!-- ── Macro Bars ─────────────────────────────────────────── -->
  <% if (metrics.macros && effectiveTarget) { %>
  <div class="nt-card p-4 mb-5">
    <div class="flex items-center justify-between mb-4">
      <p class="section-title">⚡ Phân bổ Macros <%= _dateLabel %></p>
      <% if (metrics.isAdaptiveActive) { %>
        <span class="text-[10px] font-bold bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded border border-purple-200">Đã scale theo TDEE Thích ứng</span>
      <% } %>
    </div>
    <div class="grid grid-cols-3 gap-4">
      <div>
        <div class="flex justify-between text-xs mb-1.5">
          <span class="font-bold text-blue-600">🥩 Protein</span>
          <span class="text-gray-400 font-semibold" id="macroProteinLabel"><%= consumed.protein %>/<%= (effectiveMacros || metrics.macros).protein %>g</span>
        </div>
        <div class="macro-bar-track"><div class="macro-bar-fill bg-blue-500" id="macroProteinBar" style="width:<%= macroProgress.protein %>%"></div></div>
        <p class="text-xs text-blue-400 mt-1 font-bold" id="macroProteinPct"><%= macroProgress.protein %>%</p>
      </div>
      <div>
        <div class="flex justify-between text-xs mb-1.5">
          <span class="font-bold text-amber-600">🍚 Carbs</span>
          <span class="text-gray-400 font-semibold" id="macroCarbsLabel"><%= consumed.carbs %>/<%= (effectiveMacros || metrics.macros).carbs %>g</span>
        </div>
        <div class="macro-bar-track"><div class="macro-bar-fill bg-amber-400" id="macroCarbsBar" style="width:<%= macroProgress.carbs %>%"></div></div>
        <p class="text-xs text-amber-400 mt-1 font-bold" id="macroCarbsPct"><%= macroProgress.carbs %>%</p>
      </div>
      <div>
        <div class="flex justify-between text-xs mb-1.5">
          <span class="font-bold text-rose-600">🥑 Fat</span>
          <span class="text-gray-400 font-semibold" id="macroFatLabel"><%= consumed.fat %>/<%= (effectiveMacros || metrics.macros).fat %>g</span>
        </div>
        <div class="macro-bar-track"><div class="macro-bar-fill bg-rose-400" id="macroFatBar" style="width:<%= macroProgress.fat %>%"></div></div>
        <p class="text-xs text-rose-400 mt-1 font-bold" id="macroFatPct"><%= macroProgress.fat %>%</p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Vi chất (Fiber / Sugar / Sodium) ──────────────────────── -->
  <% const hasMicro = consumed.fiber != null || consumed.sugar != null || consumed.sodium != null; %>
  <% if (hasMicro) { %>
  <div class="nt-card p-4 mb-5">
    <p class="section-title mb-4">🔬 Vi chất <%= _dateLabel %></p>
    <div class="grid grid-cols-3 gap-3">

      <!-- Fiber -->
      <% if (consumed.fiber != null) { %>
      <div class="rounded-xl p-3 text-center" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #86efac">
        <p class="text-xs font-bold text-gray-500 mb-1">🌿 Chất xơ</p>
        <p class="text-xl font-black text-green-600" id="microFiber"><%= consumed.fiber %>g</p>
        <p class="text-[10px] text-gray-400 mt-0.5">Khuyến nghị: 25–38g</p>
        <% const fiberPct = Math.min(100, Math.round((consumed.fiber / 30) * 100)); %>
        <div class="macro-bar-track mt-2"><div class="macro-bar-fill bg-green-400" style="width:<%= fiberPct %>%"></div></div>
        <p class="text-xs text-green-500 font-bold mt-1"><%= fiberPct %>%</p>
      </div>
      <% } else { %>
      <div class="rounded-xl p-3 text-center border border-dashed border-gray-200 opacity-50">
        <p class="text-xs font-bold text-gray-400 mb-1">🌿 Chất xơ</p>
        <p class="text-sm text-gray-300">Chưa có dữ liệu</p>
      </div>
      <% } %>

      <!-- Sugar -->
      <% if (consumed.sugar != null) { %>
      <% const sugarWarn = consumed.sugar > 25; %>
      <div class="rounded-xl p-3 text-center" style="background:<%= sugarWarn ? 'linear-gradient(135deg,#fff7ed,#ffedd5)' : 'linear-gradient(135deg,#fefce8,#fef9c3)' %>;border:1.5px solid <%= sugarWarn ? '#fed7aa' : '#fde68a' %>">
        <p class="text-xs font-bold text-gray-500 mb-1">🍬 Đường</p>
        <p class="text-xl font-black <%= sugarWarn ? 'text-orange-500' : 'text-amber-500' %>" id="microSugar"><%= consumed.sugar %>g</p>
        <p class="text-[10px] text-gray-400 mt-0.5">Giới hạn: &lt;25g/ngày</p>
        <% const sugarPct = Math.min(100, Math.round((consumed.sugar / 25) * 100)); %>
        <div class="macro-bar-track mt-2"><div class="macro-bar-fill <%= sugarWarn ? 'bg-orange-400' : 'bg-amber-400' %>" style="width:<%= sugarPct %>%"></div></div>
        <p class="text-xs <%= sugarWarn ? 'text-orange-500' : 'text-amber-500' %> font-bold mt-1"><%= sugarPct %>%<%= sugarWarn ? ' ⚠️' : '' %></p>
      </div>
      <% } else { %>
      <div class="rounded-xl p-3 text-center border border-dashed border-gray-200 opacity-50">
        <p class="text-xs font-bold text-gray-400 mb-1">🍬 Đường</p>
        <p class="text-sm text-gray-300">Chưa có dữ liệu</p>
      </div>
      <% } %>

      <!-- Sodium -->
      <% if (consumed.sodium != null) { %>
      <% const sodiumWarn = consumed.sodium > 1500; %>
      <div class="rounded-xl p-3 text-center" style="background:<%= sodiumWarn ? 'linear-gradient(135deg,#fff1f2,#ffe4e6)' : 'linear-gradient(135deg,#eff6ff,#dbeafe)' %>;border:1.5px solid <%= sodiumWarn ? '#fca5a5' : '#93c5fd' %>">
        <p class="text-xs font-bold text-gray-500 mb-1">🧂 Natri</p>
        <p class="text-xl font-black <%= sodiumWarn ? 'text-red-500' : 'text-blue-500' %>" id="microSodium"><%= consumed.sodium %>mg</p>
        <p class="text-[10px] text-gray-400 mt-0.5">Giới hạn: &lt;2000mg/ngày</p>
        <% const sodiumPct = Math.min(100, Math.round((consumed.sodium / 2000) * 100)); %>
        <div class="macro-bar-track mt-2"><div class="macro-bar-fill <%= sodiumWarn ? 'bg-red-400' : 'bg-blue-400' %>" style="width:<%= sodiumPct %>%"></div></div>
        <p class="text-xs <%= sodiumWarn ? 'text-red-500' : 'text-blue-500' %> font-bold mt-1"><%= sodiumPct %>%<%= sodiumWarn ? ' ⚠️' : '' %></p>
      </div>
      <% } else { %>
      <div class="rounded-xl p-3 text-center border border-dashed border-gray-200 opacity-50">
        <p class="text-xs font-bold text-gray-400 mb-1">🧂 Natri</p>
        <p class="text-sm text-gray-300">Chưa có dữ liệu</p>
      </div>
      <% } %>

    </div>
  </div>
  <% } %>

  <!-- ── Water Tracker Card ────────────────────────────────── -->
  <%
    const _wGoal    = waterGoal || 0;
    const _wTotal   = waterTotal || 0;
    const _wPct     = _wGoal > 0 ? Math.min(100, Math.round(_wTotal / _wGoal * 100)) : 0;
    const _wRemain  = _wGoal > 0 ? Math.max(0, _wGoal - _wTotal) : null;
    const _wGoalSrc = user.waterGoal ? 'tùy chỉnh' : (user.weight ? `${user.weight}kg × 35ml` : null);
  %>
  <div class="nt-card p-4 mb-5" id="waterCard">
    <div class="flex items-center justify-between mb-3">
      <p class="section-title">💧 Nước uống <%= _dateLabel %></p>
      <button onclick="openEditWaterGoal()"
              class="text-xs font-bold text-blue-500 hover:text-blue-700 flex items-center gap-1 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Sửa mục tiêu
      </button>
    </div>

    <!-- Progress Row -->
    <div class="flex items-center gap-4 mb-4">
      <div class="relative flex-shrink-0 w-20 h-20">
        <svg class="w-20 h-20 progress-ring" style="transform:rotate(-90deg)" viewBox="0 0 36 36">
          <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                fill="none" stroke="#e0f2fe" stroke-width="3.5"/>
          <path id="waterCircle"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                fill="none"
                stroke="<%= _wPct >= 100 ? '#16a34a' : '#0ea5e9' %>"
                stroke-width="3.5"
                stroke-dasharray="<%= _wPct %>, 100"
                stroke-linecap="round"
                style="filter:drop-shadow(0 0 4px rgba(14,165,233,0.4));transition:stroke-dasharray 0.5s ease"/>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span class="text-base font-black text-sky-600" id="waterPct"><%= _wPct %>%</span>
        </div>
      </div>
      <div class="flex-1">
        <p class="text-2xl font-black text-sky-700"><span id="waterTotalDisplay"><%= _wTotal %></span> <span class="text-sm font-semibold text-sky-400">ml</span></p>
        <% if (_wGoal > 0) { %>
        <p class="text-xs text-gray-400 font-medium mt-0.5">
          Mục tiêu: <strong class="text-sky-600" id="waterGoalDisplay"><%= _wGoal %></strong> ml
          <% if (_wGoalSrc) { %><span class="text-gray-300"> · (<%= _wGoalSrc %>)</span><% } %>
        </p>
        <p class="text-xs font-bold mt-0.5" id="waterRemainText">
          <% if (_wRemain > 0) { %><span class="text-sky-500">Còn thiếu: <%= _wRemain %> ml</span>
          <% } else { %><span class="text-green-600">✅ Đã đủ mục tiêu!</span><% } %>
        </p>
        <% } else { %>
        <p class="text-xs text-gray-400 mt-0.5">Cập nhật cân nặng trong <a href="/ho-so" class="text-blue-500 font-bold hover:underline">hồ sơ</a> để có mục tiêu cá nhân</p>
        <% } %>
      </div>
    </div>

    <!-- Quick Add Buttons -->
    <div class="flex flex-wrap gap-2 mb-3">
      <button onclick="quickAddWater(250)" class="water-quick-btn">+250ml <span class="opacity-60 text-[10px]">ly</span></button>
      <button onclick="quickAddWater(350)" class="water-quick-btn">+350ml <span class="opacity-60 text-[10px]">lon</span></button>
      <button onclick="quickAddWater(500)" class="water-quick-btn">+500ml <span class="opacity-60 text-[10px]">chai</span></button>
      <div class="flex items-center gap-1.5 flex-1 min-w-[160px]">
        <input type="number" id="customWaterInput" placeholder="Nhập ml tùy chỉnh"
               min="1" max="5000" step="10"
               class="nt-input text-xs py-1.5 flex-1">
        <button onclick="quickAddWater(null)"
                class="px-3 py-1.5 rounded-lg text-xs font-black text-white transition-all active:scale-95"
                style="background:linear-gradient(135deg,#0284c7,#0369a1)">Thêm</button>
      </div>
    </div>

    <!-- Log chi tiết -->
    <div id="waterLogList" class="space-y-1 max-h-44 overflow-y-auto">
      <% if (waterLogs && waterLogs.length > 0) {
           waterLogs.forEach(log => {
             const t = new Date(log.createdAt);
             const hh = String(t.getHours()).padStart(2,'0');
             const mm = String(t.getMinutes()).padStart(2,'0');
      %>
      <div class="water-log-row flex items-center gap-2 px-3 py-1.5 rounded-xl" id="wlog-<%= log.id %>">
        <span class="text-xs font-bold text-sky-500 w-10 flex-shrink-0"><%= hh %>:<%= mm %></span>
        <span class="text-xs font-black text-sky-800 w-14 flex-shrink-0">+<%= log.amount %>ml</span>
        <span class="text-xs text-gray-400 flex-1 truncate"><%= log.note || 'Nước lọc' %></span>
        <button onclick="deleteWaterLog(<%= log.id %>)" class="text-red-300 hover:text-red-500 transition-colors flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <% }); } else { %>
      <div class="text-center py-3" id="waterEmptyState">
        <p class="text-xs text-gray-300">💧 Chưa có lượng nước nào được ghi <%= _dateLabel %></p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- ── Health Insights & Warnings ────────────────────────── -->

  <% if (healthInsights && healthInsights.length > 0) { %>
  <div class="mb-5 space-y-2">
    <% healthInsights.forEach(insight => { %>
      <div class="nt-card p-3 flex items-center gap-3 border-l-4 shadow-sm animate-in fade-in slide-in-from-left-4 duration-500
                  <%= insight.type === 'error' ? 'border-red-500 bg-red-50' : 'border-amber-400 bg-amber-50' %>">
        <span class="text-xl"><%= insight.icon %></span>
        <p class="text-sm font-bold <%= insight.type === 'error' ? 'text-red-700' : 'text-amber-700' %>">
          <%= insight.message %>
        </p>
      </div>
    <% }); %>
  </div>
  <% } %>

  <!-- ── Meal Cards Grid ────────────────────────────────────── -->
  <% const mealConfig = [
    { key:'sang', label:'Bữa Sáng', icon:'🌅', accent:'#d97706', bg:'linear-gradient(135deg,#fffbeb,#fef3c7)', border:'#fde68a' },
    { key:'trua', label:'Bữa Trưa', icon:'☀️', accent:'#15803d', bg:'linear-gradient(135deg,#f0fdf4,#dcfce7)', border:'#86efac' },
    { key:'toi',  label:'Bữa Tối',  icon:'🌙', accent:'#4f46e5', bg:'linear-gradient(135deg,#eef2ff,#e0e7ff)', border:'#a5b4fc' },
    { key:'phu',  label:'Bữa Phụ',  icon:'🍎', accent:'#be123c', bg:'linear-gradient(135deg,#fff1f2,#ffe4e6)', border:'#fca5a5' },
  ]; %>
  <div class="grid md:grid-cols-2 gap-4 mb-5">
    <% mealConfig.forEach(meal => { %>
    <div class="meal-card" id="meal-card-<%= meal.key %>">
      <!-- Header -->
      <div class="meal-card-header" style="background:<%= meal.bg %>">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl"><%= meal.icon %></span>
          <div>
            <h3 class="font-black text-sm text-gray-800"><%= meal.label %></h3>
            <p class="text-xs font-bold" style="color:<%= meal.accent %>" id="mealCal-<%= meal.key %>">Đã nạp: <%= mealCalories[meal.key] %> kcal</p>
          </div>
        </div>
        <button onclick="openAddModal('<%= meal.key %>')"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-black text-white transition-all hover:opacity-90 active:scale-95"
                style="background:<%= meal.accent %>;box-shadow:0 2px 8px rgba(0,0,0,0.15)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
          Thêm
        </button>
      </div>
      <!-- Food rows -->
      <% if (mealGroups[meal.key] && mealGroups[meal.key].length > 0) { %>
        <% mealGroups[meal.key].forEach(entry => { %>
        <div class="food-row" id="entry-<%= entry.id %>"
             data-meal="<%= meal.key %>"
             data-calories="<%= entry.caloriesSnapshot||0 %>"
             data-protein="<%= entry.proteinSnapshot||0 %>"
             data-carbs="<%= entry.carbsSnapshot||0 %>"
             data-fat="<%= entry.fatSnapshot||0 %>">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-800 truncate">
              <%= entry.food ? entry.food.name : 'Món không xác định' %>
            </p>
            <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
              <span class="text-xs text-gray-400 font-medium"><% if (entry.food && entry.food.unit === '100g') { %><%= Math.round(entry.amount * 100) %>g<% } else { %><%= entry.amount %> <%= entry.food ? entry.food.unit : '' %><% } %></span>
              <span class="text-xs font-black text-green-600"><%= Math.round(entry.caloriesSnapshot||0) %> kcal</span>
              <span class="pill pill-blue">P:<%= Math.round(entry.proteinSnapshot||0) %>g</span>
              <span class="pill pill-amber">C:<%= Math.round(entry.carbsSnapshot||0) %>g</span>
              <span class="pill pill-rose">F:<%= Math.round(entry.fatSnapshot||0) %>g</span>
              <% if (entry.fiberSnapshot != null) { %><span class="pill" style="background:#dcfce7;color:#15803d">Xơ:<%= Math.round(entry.fiberSnapshot*10)/10 %>g</span><% } %>
              <% if (entry.sugarSnapshot != null) { %><span class="pill" style="background:#fef9c3;color:#a16207">Đ:<%= Math.round(entry.sugarSnapshot*10)/10 %>g</span><% } %>
            </div>
          </div>
          <button onclick="deleteEntry(<%= entry.id %>)" class="del-btn ml-2 p-1.5 rounded-lg text-red-400 hover:bg-red-50 hover:text-red-600 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
        <% }); %>
      <% } else { %>
        <div class="text-center py-6 text-gray-300 empty-meal" id="empty-meal-<%= meal.key %>">
          <p class="text-3xl mb-1"><%= meal.icon %></p>
          <p class="text-sm text-gray-400">Chưa có món nào ·
            <button onclick="openAddModal('<%= meal.key %>')" class="text-green-500 font-bold hover:underline">Thêm ngay</button>
          </p>
        </div>
      <% } %>
    </div>
    <% }); %>
  </div>

  <!-- Gỡ bỏ phần Kế hoạch dinh dưỡng theo bữa theo yêu cầu: Đơn giản hóa trải nghiệm -->

</main>

<!-- ═══ Modal Thêm Món ═══════════════════════════════════════════ -->
<dialog id="addFoodModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-lg rounded-2xl p-6">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-gray-400">✕</button>
    </form>
    <h3 class="font-black text-lg text-gray-800 mb-5 flex items-center gap-2">
      <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-sm"
            style="background:linear-gradient(135deg,#16a34a,#059669)">➕</span>
      Thêm Món Ăn
    </h3>

    <div class="flex flex-col sm:flex-row gap-2 mb-3">
      <input type="text" id="searchFoodInput" placeholder="Tìm tên món (cơm, phở, thịt...)"
             class="nt-input flex-1 text-sm" oninput="debounceSearch(this.value)" autocomplete="off">
      <div class="flex gap-2">
        <select id="categoryFilter" class="nt-select text-sm w-40"
                onchange="debounceSearch(document.getElementById('searchFoodInput').value)">
          <option value="">Nhóm: Tất cả</option>
          <optgroup label="Nguyên liệu thô">
            <option value="protein">Đạm (Protein)</option>
            <option value="carb">Tinh bột (Carb)</option>
            <option value="fat">Chất béo (Fat)</option>
            <option value="fiber">Chất xơ / Rau củ (Fiber)</option>
            <option value="vitamin">Vitamin / Trái cây</option>
          </optgroup>
          <optgroup label="Món chế biến">
            <option value="com">Cơm & Xôi</option>
            <option value="pho_bun">Phở, Bún</option>
            <option value="banh">Bánh</option>
            <option value="rau_cu">Rau củ</option>
            <option value="thit_ca">Thịt & Cá</option>
            <option value="do_uong">Đồ uống</option>
            <option value="trai_cay">Trái cây</option>
            <option value="khac">Khác</option>
          </optgroup>
        </select>
      </div>
    </div>

    <!-- Gợi ý tạo món mới nếu không tìm thấy -->
    <div class="mb-2">
      <a href="/nhat-ky/mon-cua-toi"
         class="w-full flex items-center justify-center gap-2 py-2 rounded-xl text-xs font-bold text-violet-600 hover:bg-violet-50 transition-all border border-dashed border-violet-200 hover:border-violet-400">
        🔧 Không tìm thấy? Tự tạo món ăn mới
      </a>
    </div>

    <!-- Results -->
    <div id="searchResults" class="hidden max-h-48 overflow-y-auto rounded-xl border border-gray-100 mb-3 shadow-sm">
      <div id="searchResultsList"></div>
    </div>

    <!-- Selected Preview -->
    <div id="selectedFoodPreview" class="hidden rounded-xl p-3 mb-3" style="background:#f0fdf4;border:1.5px solid #86efac">
      <p class="font-black text-green-700 text-sm" id="selectedFoodName">–</p>
      <p class="text-xs text-gray-500 mt-0.5" id="selectedFoodMacros">–</p>
    </div>

    <!-- Form -->
    <form id="addFoodForm" class="space-y-3">
      <input type="hidden" id="selectedFoodId">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1">Số lượng</label>
          <input type="number" id="foodAmount" value="1" min="0.1" step="0.1"
                 class="nt-input text-sm" oninput="updateCaloriePreview()">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1">Bữa ăn</label>
          <select id="foodMealType" class="nt-select w-full text-sm">
            <option value="sang">🌅 Bữa sáng</option>
            <option value="trua">☀️ Bữa trưa</option>
            <option value="toi">🌙 Bữa tối</option>
            <option value="phu">🍎 Bữa phụ</option>
          </select>
        </div>
      </div>

      <div id="caloriePreview" class="hidden text-center py-2.5 rounded-xl" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #86efac">
        <p class="text-sm text-gray-600 font-medium">Tổng: <strong class="text-green-600 text-base font-black" id="previewCalories">0</strong> kcal</p>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Ghi chú (tùy chọn)</label>
        <input type="text" id="foodNote" placeholder="Ví dụ: thêm đường, bỏ hành..."
               class="nt-input text-sm">
      </div>

      <div class="flex gap-2 pt-1">
        <button type="button" onclick="document.getElementById('addFoodModal').close()"
                class="flex-1 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:bg-gray-100 transition-all border border-gray-200">Hủy</button>
        <button type="button" onclick="submitAddFood()"
                class="flex-1 py-2.5 rounded-xl text-sm font-black text-white transition-all active:scale-95"
                style="background:linear-gradient(135deg,#16a34a,#059669);box-shadow:0 4px 12px rgba(22,163,74,0.3)">
          ✅ Thêm vào nhật ký
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>đóng</button></form>
</dialog>

<script>
const CURRENT_DATE = '<%= date %>';
let selectedFood = null, searchTimer = null;

// goToToday() đã được thay bằng thẻ <a> trong HTML (không cần JS nữa)

function openAddModal(mealType) {
  selectedFood = null;
  ['selectedFoodId','searchFoodInput','foodNote'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('foodAmount').value = '1';
  ['searchResults','selectedFoodPreview','caloriePreview'].forEach(id => document.getElementById(id).classList.add('hidden'));
  if (mealType) document.getElementById('foodMealType').value = mealType;
  document.getElementById('addFoodModal').showModal();
  setTimeout(() => document.getElementById('searchFoodInput').focus(), 100);
  searchFood('');
}

function quickAdd(foodData) {
  openAddModal(null);
  setTimeout(() => selectFood(foodData), 150);
}

function debounceSearch(q) {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => searchFood(q), 280);
}

async function searchFood(query) {
  const category = document.getElementById('categoryFilter').value;
  try {
    const res  = await fetch('/nhat-ky/tim-mon?' + new URLSearchParams({q:query,category,limit:100}));
    const data = await res.json();
    renderSearchResults(data.foods || []);
  } catch(e) { console.error(e); }
}

function renderSearchResults(foods) {
  const list = document.getElementById('searchResultsList');
  const wrap = document.getElementById('searchResults');
  if (!foods.length) {
    list.innerHTML = '<p class="text-center text-sm text-gray-400 py-4">Không tìm thấy món phù hợp</p>';
    wrap.classList.remove('hidden'); return;
  }
  list.innerHTML = foods.map(f => {
    const safe = JSON.stringify(f).replace(/</g,'\\u003c').replace(/>/g,'\\u003e');
    let badgeHtml;
    if (f.isCustom) {
      badgeHtml = '<span class="ml-2 text-[10px] px-1.5 py-0.5 rounded-md bg-violet-100 text-violet-700">🔧 Tự tạo</span>';
    } else if (f.foodType === 'raw') {
      badgeHtml = '<span class="ml-2 text-[10px] px-1.5 py-0.5 rounded-md bg-amber-100 text-amber-700">Thô</span>';
    } else {
      badgeHtml = '<span class="ml-2 text-[10px] px-1.5 py-0.5 rounded-md bg-blue-100 text-blue-700">Chế biến</span>';
    }
    
    return `<button type="button" class="w-full text-left px-4 py-2.5 hover:bg-green-50 transition-colors border-b border-gray-50 last:border-0"
              data-food='${safe.replace(/'/g,"\\u0027")}' onclick="selectFood(JSON.parse(this.dataset.food))">
      <p class="font-bold text-sm text-gray-800 flex items-center">${f.name.replace(/</g,'&lt;')} ${badgeHtml}</p>
      <p class="text-xs text-gray-400 mt-0.5">${f.calories} kcal / ${f.unit} · P:${f.protein}g C:${f.carbs}g F:${f.fat}g${f.fiber!=null?' · Xơ:'+f.fiber+'g':''}${f.sugar!=null?' · Đường:'+f.sugar+'g':''}</p>
    </button>`;
  }).join('');
  wrap.classList.remove('hidden');
}

function selectFood(food) {
  selectedFood = food;
  document.getElementById('selectedFoodId').value = food.id;
  document.getElementById('searchFoodInput').value = food.name;
  document.getElementById('searchResults').classList.add('hidden');
  document.getElementById('selectedFoodName').textContent = food.name;
  const microParts = [];
  if (food.fiber  != null) microParts.push(`Xơ: ${food.fiber}g`);
  if (food.sugar  != null) microParts.push(`Đường: ${food.sugar}g`);
  if (food.sodium != null) microParts.push(`Natri: ${food.sodium}mg`);
  document.getElementById('selectedFoodMacros').textContent =
    `${food.calories} kcal / ${food.unit} · P: ${food.protein}g · C: ${food.carbs}g · F: ${food.fat}g` +
    (microParts.length ? ' · ' + microParts.join(' · ') : '');
  document.getElementById('selectedFoodPreview').classList.remove('hidden');
  updateCaloriePreview();
  document.getElementById('foodAmount').focus();
}

function updateCaloriePreview() {
  if (!selectedFood) return;
  const kcal = Math.round(selectedFood.calories * (parseFloat(document.getElementById('foodAmount').value)||0));
  document.getElementById('previewCalories').textContent = kcal;
  document.getElementById('caloriePreview').classList.remove('hidden');
}

async function submitAddFood() {
  const foodId   = document.getElementById('selectedFoodId').value;
  const amount   = document.getElementById('foodAmount').value;
  const mealType = document.getElementById('foodMealType').value;
  const note     = document.getElementById('foodNote').value;
  if (!foodId) { showToast('Vui lòng chọn một món ăn.','warning'); return; }
  if (!amount || parseFloat(amount) <= 0) { showToast('Số lượng phải lớn hơn 0.','warning'); return; }
  try {
    showLoading();
    const res  = await fetch('/nhat-ky/them', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({foodId,amount,mealType,date:CURRENT_DATE,note}),
    });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      document.getElementById('addFoodModal').close();
      showToast(data.message,'success');
      appendNewEntryToDOM(data.entry);
    } else { showToast(data.message||'Có lỗi xảy ra.','error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.','error'); }
}

// ── Các hằng số dinh dưỡng (được ghi vào DOM bởi EJS) ──────────────────────
const EFFECTIVE_TARGET = <%= effectiveTarget || metrics.targetCalories || 0 %>;
const MACRO_TARGET = {
  protein: <%= (effectiveMacros || metrics.macros) ? (effectiveMacros || metrics.macros).protein : 0 %>,
  carbs:   <%= (effectiveMacros || metrics.macros) ? (effectiveMacros || metrics.macros).carbs   : 0 %>,
  fat:     <%= (effectiveMacros || metrics.macros) ? (effectiveMacros || metrics.macros).fat     : 0 %>,
};
// Trạng thái hiện tại (mutable)
let _consumed = {
  calories: <%= consumed.calories %>,
  protein:  <%= consumed.protein %>,
  carbs:    <%= consumed.carbs %>,
  fat:      <%= consumed.fat %>,
};
// Calories theo bữa
const _mealCal = {
  sang: <%= mealCalories.sang %>,
  trua: <%= mealCalories.trua %>,
  toi:  <%= mealCalories.toi %>,
  phu:  <%= mealCalories.phu %>,
};

function _updateStatsUI() {
  const cal = Math.round(_consumed.calories);
  const rem = Math.max(0, EFFECTIVE_TARGET - cal);
  const pct = EFFECTIVE_TARGET > 0 ? Math.min(100, Math.round(cal / EFFECTIVE_TARGET * 100)) : 0;

  // Stat cards
  const scEl = document.getElementById('statConsumed');
  if (scEl) scEl.textContent = cal;
  const srEl = document.getElementById('statRemaining');
  if (srEl) srEl.textContent = rem;
  const spEl = document.getElementById('statProgress');
  if (spEl) spEl.textContent = pct + '%';
  const spbEl = document.getElementById('statProgressBar');
  if (spbEl) spbEl.style.width = pct + '%';

  // Macro bars
  const p = Math.round(_consumed.protein);
  const c = Math.round(_consumed.carbs);
  const f = Math.round(_consumed.fat);
  const pPct = MACRO_TARGET.protein > 0 ? Math.min(100, Math.round(p / MACRO_TARGET.protein * 100)) : 0;
  const cPct = MACRO_TARGET.carbs   > 0 ? Math.min(100, Math.round(c / MACRO_TARGET.carbs   * 100)) : 0;
  const fPct = MACRO_TARGET.fat     > 0 ? Math.min(100, Math.round(f / MACRO_TARGET.fat     * 100)) : 0;

  const pLbl = document.getElementById('macroProteinLabel');
  if (pLbl) pLbl.textContent = `${p}/${MACRO_TARGET.protein}g`;
  const pBar = document.getElementById('macroProteinBar');
  if (pBar) pBar.style.width = pPct + '%';
  const pPctEl = document.getElementById('macroProteinPct');
  if (pPctEl) pPctEl.textContent = pPct + '%';

  const cLbl = document.getElementById('macroCarbsLabel');
  if (cLbl) cLbl.textContent = `${c}/${MACRO_TARGET.carbs}g`;
  const cBar = document.getElementById('macroCarbsBar');
  if (cBar) cBar.style.width = cPct + '%';
  const cPctEl = document.getElementById('macroCarbsPct');
  if (cPctEl) cPctEl.textContent = cPct + '%';

  const fLbl = document.getElementById('macroFatLabel');
  if (fLbl) fLbl.textContent = `${f}/${MACRO_TARGET.fat}g`;
  const fBar = document.getElementById('macroFatBar');
  if (fBar) fBar.style.width = fPct + '%';
  const fPctEl = document.getElementById('macroFatPct');
  if (fPctEl) fPctEl.textContent = fPct + '%';
}

function appendNewEntryToDOM(entry) {
  const addCal  = parseFloat(entry.caloriesSnapshot) || 0;
  const addPro  = parseFloat(entry.proteinSnapshot) || 0;
  const addCarb = parseFloat(entry.carbsSnapshot) || 0;
  const addFat  = parseFloat(entry.fatSnapshot) || 0;
  const mealKey = entry.mealType;

  _consumed.calories += addCal;
  _consumed.protein  += addPro;
  _consumed.carbs    += addCarb;
  _consumed.fat      += addFat;

  if (mealKey && _mealCal[mealKey] !== undefined) {
    _mealCal[mealKey] += addCal;
    const mhEl = document.getElementById(`mealCal-${mealKey}`);
    if (mhEl) {
      mhEl.textContent = `Đã nạp: ${Math.round(_mealCal[mealKey])} kcal`;
    }
  }

  _updateStatsUI();

  const emptyEl = document.getElementById(`empty-meal-${mealKey}`);
  if (emptyEl) emptyEl.remove();

  const row = document.createElement('div');
  row.className = 'food-row';
  row.id = `entry-${entry.id}`;
  row.dataset.meal = mealKey;
  row.dataset.calories = addCal;
  row.dataset.protein = addPro;
  row.dataset.carbs = addCarb;
  row.dataset.fat = addFat;

  let microHtml = '';
  if (entry.fiberSnapshot != null) microHtml += `<span class="pill" style="background:#dcfce7;color:#15803d">Xơ:${Math.round(entry.fiberSnapshot*10)/10}g</span>`;
  if (entry.sugarSnapshot != null) microHtml += `<span class="pill" style="background:#fef9c3;color:#a16207">Đ:${Math.round(entry.sugarSnapshot*10)/10}g</span>`;

  row.innerHTML = `
    <div class="flex-1 min-w-0">
      <p class="text-sm font-bold text-gray-800 truncate">${entry.foodName || 'Món không xác định'}</p>
      <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
        <span class="text-xs text-gray-400 font-medium">${entry.unit === '100g' ? Math.round(entry.amount * 100) + 'g' : entry.amount + ' ' + (entry.unit || '')}</span>
        <span class="text-xs font-black text-green-600">${Math.round(addCal)} kcal</span>
        <span class="pill pill-blue">P:${Math.round(addPro)}g</span>
        <span class="pill pill-amber">C:${Math.round(addCarb)}g</span>
        <span class="pill pill-rose">F:${Math.round(addFat)}g</span>
        ${microHtml}
      </div>
    </div>
    <button onclick="deleteEntry(${entry.id})" class="del-btn ml-2 p-1.5 rounded-lg text-red-400 hover:bg-red-50 hover:text-red-600 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
    </button>
  `;

  row.style.opacity = '0';
  row.style.transform = 'translateY(-10px)';
  
  const mealCard = document.getElementById(`meal-card-${mealKey}`);
  if (mealCard) {
    mealCard.appendChild(row);
    void row.offsetWidth;
    row.style.transition = 'all 0.3s ease';
    row.style.opacity = '1';
    row.style.transform = 'translateY(0)';
  }
}

async function deleteEntry(id) {
  if (!confirm('Bạn có chắc muốn xóa mục này không?')) return;
  const el = document.getElementById(`entry-${id}`);
  // Đọc snapshot từ data attributes trước khi remove
  const delCal  = parseFloat(el ? el.dataset.calories : 0) || 0;
  const delPro  = parseFloat(el ? el.dataset.protein  : 0) || 0;
  const delCarb = parseFloat(el ? el.dataset.carbs    : 0) || 0;
  const delFat  = parseFloat(el ? el.dataset.fat      : 0) || 0;
  const mealKey = el ? el.dataset.meal : null;
  try {
    showLoading();
    const res  = await fetch(`/nhat-ky/xoa/${id}`, {method:'DELETE'});
    const data = await res.json();
    hideLoading();
    if (data.success) {
      // 1. Animate + remove DOM
      if (el) {
        el.style.transition = 'all 0.3s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateX(20px)';
        el.style.maxHeight = el.offsetHeight + 'px';
        setTimeout(() => {
          el.style.maxHeight = '0';
          el.style.overflow = 'hidden';
          el.style.margin = '0';
          el.style.padding = '0';
          setTimeout(() => el.remove(), 200);
        }, 250);
      }
      // 2. Cập nhật state
      _consumed.calories -= delCal;
      _consumed.protein  -= delPro;
      _consumed.carbs    -= delCarb;
      _consumed.fat      -= delFat;
      if (mealKey && _mealCal[mealKey] !== undefined) {
        _mealCal[mealKey] = Math.max(0, _mealCal[mealKey] - delCal);
        const mhEl = document.getElementById(`mealCal-${mealKey}`);
        if (mhEl) {
          mhEl.textContent = `Đã nạp: ${Math.round(_mealCal[mealKey])} kcal`;
        }
      }
      // 3. Cập nhật stat cards + macro bars
      _updateStatsUI();
      showToast(data.message, 'success');
    } else { showToast(data.message||'Lỗi.','error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.','error'); }
}
</script>

<!-- ═══ Modal Sửa Mục Tiêu Nước ══════════════════════════════════════════ -->
<dialog id="editWaterGoalModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-sm rounded-2xl p-6">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-gray-400">✕</button>
    </form>
    <h3 class="font-black text-lg text-gray-800 mb-1 flex items-center gap-2">
      <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-sm"
            style="background:linear-gradient(135deg,#0284c7,#0369a1)">💧</span>
      Sửa Mục Tiêu Nước
    </h3>
    <p class="text-xs text-gray-400 mb-4">Mặc định tính theo cân nặng × 35ml. Bạn có thể tùy chỉnh theo nhu cầu cá nhân.</p>
    <div>
      <label class="block text-xs font-bold text-gray-600 mb-1">Mục tiêu (ml/ngày)</label>
      <input type="number" id="newWaterGoalInput" min="500" max="10000" step="50"
             class="nt-input text-sm w-full" placeholder="VD: 2000 (tối thiểu 500ml)">
    </div>
    <div class="flex gap-2 pt-3">
      <button type="button" onclick="document.getElementById('editWaterGoalModal').close()"
              class="flex-1 py-2.5 rounded-xl text-sm font-bold text-gray-500 hover:bg-gray-100 transition-all border border-gray-200">Hủy</button>
      <button type="button" onclick="saveWaterGoal()"
              class="flex-1 py-2.5 rounded-xl text-sm font-black text-white transition-all active:scale-95"
              style="background:linear-gradient(135deg,#0284c7,#0369a1);box-shadow:0 4px 12px rgba(2,132,199,0.3)">
        💾 Lưu mục tiêu
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>đóng</button></form>
</dialog>

<style>
.water-quick-btn {
  padding: 6px 12px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 800;
  color: white;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(14,165,233,0.3);
}
.water-quick-btn:hover { opacity: 0.9; transform: translateY(-1px); }
.water-quick-btn:active { transform: scale(0.95); }
.water-log-row {
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  border: 1px solid #bae6fd;
  transition: all 0.2s ease;
}
.water-log-row:hover { border-color: #7dd3fc; }
</style>

<script>
// ── Water Tracker State ────────────────────────────────────────────────────────
let _waterTotal   = <%= waterTotal || 0 %>;
let _waterGoal    = <%= waterGoal || 0 %>;
let _isAddingWater = false; // [QA-FIX] Anti-spam flag: chặn spam click

// [QA-FIX] Escape HTML để chống XSS khi inject dữ liệu user vào innerHTML
function _escHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function _updateWaterUI(newTotal) {
  _waterTotal = newTotal;
  const pct    = _waterGoal > 0 ? Math.min(100, Math.round(newTotal / _waterGoal * 100)) : 0;
  const remain = _waterGoal > 0 ? Math.max(0, _waterGoal - newTotal) : null;

  const totalEl = document.getElementById('waterTotalDisplay');
  if (totalEl) totalEl.textContent = newTotal;

  const pctEl = document.getElementById('waterPct');
  if (pctEl) pctEl.textContent = pct + '%';

  const circle = document.getElementById('waterCircle');
  if (circle) {
    circle.setAttribute('stroke-dasharray', `${pct}, 100`);
    circle.setAttribute('stroke', pct >= 100 ? '#16a34a' : '#0ea5e9');
  }

  const remainEl = document.getElementById('waterRemainText');
  if (remainEl && _waterGoal > 0) {
    remainEl.innerHTML = remain > 0
      ? `<span class="text-sky-500">Còn thiếu: ${remain} ml</span>`
      : `<span class="text-green-600">✅ Đã đủ mục tiêu!</span>`;
  }
}

// [QA-FIX] Helper: enable/disable tất cả water buttons khi đang request
function _setWaterBtns(disabled) {
  document.querySelectorAll('.water-quick-btn').forEach(btn => {
    btn.disabled = disabled;
    btn.style.opacity = disabled ? '0.5' : '1';
    btn.style.cursor  = disabled ? 'not-allowed' : 'pointer';
  });
  const customBtn = document.querySelector('#customWaterInput + button, .water-quick-btn:last-of-type');
}

// ── Quick Add Water ────────────────────────────────────────────────────────────
async function quickAddWater(preset) {
  // [QA-FIX] Chặn spam click: nếu đang có request đang chạy thì bỏ qua
  if (_isAddingWater) { showToast('Đang xử lý, vui lòng chờ...', 'warning'); return; }

  let amount = preset;
  if (amount === null) {
    const input = document.getElementById('customWaterInput');
    amount = parseInt(input ? input.value : 0);
    if (!amount || amount <= 0) { showToast('Vui lòng nhập lượng nước hợp lệ.', 'warning'); return; }
    if (amount > 5000)          { showToast('Lượng nước tối đa 5000 ml.', 'warning'); return; }
  }
  try {
    _isAddingWater = true;  // [QA-FIX] Lock
    _setWaterBtns(true);    // [QA-FIX] Disable tất cả nút water
    showLoading();
    const res  = await fetch('/nuoc/them', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amount, date: CURRENT_DATE }),
    });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      _updateWaterUI(data.todayTotal);
      _appendWaterLog(data.waterLog);
      showToast(data.message, 'success');
      const inp = document.getElementById('customWaterInput');
      if (inp) inp.value = '';
    } else { showToast(data.message || 'Có lỗi xảy ra.', 'error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.', 'error'); }
  finally {
    _isAddingWater = false; // [QA-FIX] Unlock dù thành công hay lỗi
    _setWaterBtns(false);   // [QA-FIX] Re-enable buttons
  }
}

// ── Append water log entry to DOM ─────────────────────────────────────────────
function _appendWaterLog(log) {
  const list = document.getElementById('waterLogList');
  if (!list) return;

  // Xóa empty state nếu có
  const empty = document.getElementById('waterEmptyState');
  if (empty) empty.remove();

  const t  = new Date(log.createdAt);
  const hh = String(t.getHours()).padStart(2, '0');
  const mm = String(t.getMinutes()).padStart(2, '0');

  const row = document.createElement('div');
  row.className = 'water-log-row flex items-center gap-2 px-3 py-1.5 rounded-xl';
  row.id = `wlog-${log.id}`;
  row.style.opacity = '0';
  row.style.transform = 'translateY(-8px)';
  // [QA-FIX] Dùng _escHtml() cho log.note để chống XSS khi inject vào innerHTML
  row.innerHTML = `
    <span class="text-xs font-bold text-sky-500 w-10 flex-shrink-0">${hh}:${mm}</span>
    <span class="text-xs font-black text-sky-800 w-14 flex-shrink-0">+${log.amount}ml</span>
    <span class="text-xs text-gray-400 flex-1 truncate">${_escHtml(log.note) || 'Nước lọc'}</span>
    <button onclick="deleteWaterLog(${Number(log.id)})" class="text-red-300 hover:text-red-500 transition-colors flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  `;
  list.appendChild(row);
  void row.offsetWidth;
  row.style.transition = 'all 0.3s ease';
  row.style.opacity = '1';
  row.style.transform = 'translateY(0)';
}

// ── Delete water log ───────────────────────────────────────────────────────────
async function deleteWaterLog(id) {
  const el = document.getElementById(`wlog-${id}`);
  try {
    showLoading();
    const res  = await fetch(`/nuoc/xoa/${id}`, { method: 'DELETE' });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      if (el) {
        el.style.transition = 'all 0.25s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateX(20px)';
        setTimeout(() => el.remove(), 250);
      }
      _updateWaterUI(data.todayTotal);
      // Nếu log list rỗng → show empty state
      setTimeout(() => {
        const list = document.getElementById('waterLogList');
        if (list && list.querySelectorAll('.water-log-row').length === 0) {
          list.innerHTML = `<div class="text-center py-3" id="waterEmptyState">
            <p class="text-xs text-gray-300">💧 Chưa có lượng nước nào được ghi hôm nay</p>
          </div>`;
        }
      }, 300);
      showToast(data.message, 'success');
    } else { showToast(data.message || 'Lỗi.', 'error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.', 'error'); }
}

// ── Edit Water Goal ────────────────────────────────────────────────────────────
function openEditWaterGoal() {
  const input = document.getElementById('newWaterGoalInput');
  if (input) input.value = _waterGoal || '';
  document.getElementById('editWaterGoalModal').showModal();
  setTimeout(() => { if (input) input.focus(); }, 100);
}

async function saveWaterGoal() {
  const val = parseInt(document.getElementById('newWaterGoalInput').value);
  if (!val || val < 500 || val > 10000) {
    showToast('Mục tiêu nước phải từ 500 ml đến 10000 ml.', 'warning'); // [QA-FIX] sync với backend
    return;
  }
  try {
    showLoading();
    const res  = await fetch('/nuoc/muc-tieu', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ waterGoal: val }),
    });
    const data = await res.json();
    hideLoading();
    if (data.success) {
      _waterGoal = data.newGoal;
      const goalEl = document.getElementById('waterGoalDisplay');
      if (goalEl) goalEl.textContent = data.newGoal;
      // [QA-FIX] Cập nhật label nguồn sang "tùy chỉnh" sau khi user ghi đè
      const srcEl = goalEl ? goalEl.nextElementSibling : null;
      if (srcEl && srcEl.tagName === 'SPAN') srcEl.textContent = ' · (tùy chỉnh)';
      _updateWaterUI(_waterTotal);
      document.getElementById('editWaterGoalModal').close();
      showToast(data.message, 'success');
    } else { showToast(data.message || 'Lỗi.', 'error'); }
  } catch(e) { hideLoading(); showToast('Lỗi kết nối.', 'error'); }
}
</script>

<%- include('../partials/footer') %>
