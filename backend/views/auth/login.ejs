<%- include('../partials/header', { title: 'Đăng Nhập' }) %>

<div class="min-h-screen flex" style="background:linear-gradient(135deg,#f0fdf4 0%,#dcfce7 40%,#d1fae5 100%)">

  <!-- Left Panel — Branding (desktop only) -->
  <div class="hidden lg:flex flex-col justify-center items-center w-1/2 p-12"
       style="background:linear-gradient(135deg,#16a34a 0%,#059669 50%,#0d9488 100%)">
    <div class="text-center">
      <div class="w-20 h-20 rounded-3xl bg-white/20 flex items-center justify-center mx-auto mb-6 backdrop-blur-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </div>
      <h1 class="text-4xl font-extrabold text-white mb-3">NutriTrack</h1>
      <p class="text-green-100 text-lg mb-10">Hệ thống quản lý dinh dưỡng cá nhân hóa</p>
      <div class="space-y-4 text-left max-w-xs">
        <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm rounded-xl p-3">
          <span class="text-2xl">🎯</span>
          <div>
            <p class="font-semibold text-white text-sm">Tính toán TDEE/BMR</p>
            <p class="text-green-200 text-xs">Dựa trên chỉ số cơ thể của bạn</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm rounded-xl p-3">
          <span class="text-2xl">📔</span>
          <div>
            <p class="font-semibold text-white text-sm">Nhật ký ăn uống</p>
            <p class="text-green-200 text-xs">Theo dõi từng bữa ăn mỗi ngày</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm rounded-xl p-3">
          <span class="text-2xl">📊</span>
          <div>
            <p class="font-semibold text-white text-sm">Biểu đồ trực quan</p>
            <p class="text-green-200 text-xs">Theo dõi tiến trình cân nặng</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Panel — Login Form -->
  <div class="flex-1 flex flex-col justify-center items-center px-6 py-12">

    <!-- Mobile Logo -->
    <div class="lg:hidden text-center mb-8">
      <div class="auth-logo text-3xl mb-1">NutriTrack</div>
      <p class="text-sm text-gray-500">Hệ thống quản lý dinh dưỡng</p>
    </div>

    <div class="auth-card w-full">
      <h2 class="text-2xl font-extrabold text-gray-800 mb-1">Chào mừng trở lại! 👋</h2>
      <p class="text-sm text-gray-500 mb-6">Đăng nhập để tiếp tục hành trình sức khỏe</p>

      <!-- Error Alert -->
      <% if (error) { %>
      <div class="flex items-center gap-3 p-3 rounded-xl mb-5" style="background:#fff1f2;border:1px solid #fecdd3">
        <span>❌</span>
        <p class="text-sm font-semibold text-red-600"><%= error %></p>
      </div>
      <% } %>

      <form action="/dang-nhap" method="POST" class="space-y-4" id="loginForm">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1" for="email">Email</label>
          <input type="email" id="email" name="email"
                 placeholder="email@example.com"
                 class="nt-input" required autofocus>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1" for="password">Mật khẩu</label>
          <div class="relative">
            <input type="password" id="password" name="password"
                   placeholder="••••••••"
                   class="nt-input pr-10" required>
            <button type="button" onclick="togglePw('password','eyePw')"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors">
              <svg id="eyePw" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" id="loginBtn"
                class="w-full py-3 rounded-xl text-white font-bold text-sm transition-all mt-2"
                style="background:linear-gradient(135deg,#16a34a,#059669);box-shadow:0 4px 16px rgba(22,163,74,0.3)">
          Đăng Nhập →
        </button>
      </form>

      <div class="relative my-5">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-100"></div></div>
        <div class="relative flex justify-center">
          <span class="bg-white px-3 text-xs text-gray-400 font-semibold">HOẶC</span>
        </div>
      </div>

      <p class="text-center text-sm text-gray-500">
        Chưa có tài khoản?
        <a href="/dang-ky" class="font-bold text-green-600 hover:underline">Đăng ký miễn phí</a>
      </p>
    </div>
  </div>
</div>

<script>
function togglePw(inputId, iconId) {
  const input = document.getElementById(inputId);
  input.type = input.type === 'password' ? 'text' : 'password';
}
document.getElementById('loginForm').addEventListener('submit', () => {
  const btn = document.getElementById('loginBtn');
  btn.textContent = '⏳ Đang đăng nhập...';
  btn.disabled = true;
});
</script>

<%- include('../partials/footer') %>
