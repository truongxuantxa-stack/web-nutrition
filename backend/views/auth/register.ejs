<%- include('../partials/header', { title: 'Đăng Ký' }) %>

<div class="min-h-screen flex items-center justify-center px-4 py-12"
     style="background:linear-gradient(135deg,#f0fdf4 0%,#dcfce7 40%,#d1fae5 100%)">

  <div class="w-full max-w-md">

    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="auth-logo text-3xl mb-1">NutriTrack</div>
      <p class="text-sm text-gray-500">Bắt đầu hành trình sức khỏe của bạn</p>
    </div>

    <div class="auth-card">
      <h2 class="text-2xl font-extrabold text-gray-800 mb-1">Tạo tài khoản miễn phí 🎉</h2>
      <p class="text-sm text-gray-500 mb-6">Chỉ mất 30 giây để bắt đầu</p>

      <!-- Error -->
      <% if (error) { %>
      <div class="flex items-center gap-3 p-3 rounded-xl mb-5" style="background:#fff1f2;border:1px solid #fecdd3">
        <span>❌</span>
        <p class="text-sm font-semibold text-red-600"><%= error %></p>
      </div>
      <% } %>

      <form action="/dang-ky" method="POST" class="space-y-4" id="registerForm">

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Họ và tên <span class="text-red-500">*</span></label>
          <input type="text" name="fullName" placeholder="Nguyễn Văn A"
                 class="nt-input" required autofocus>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Email <span class="text-red-500">*</span></label>
          <input type="email" name="email" placeholder="email@example.com"
                 class="nt-input" required>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Mật khẩu <span class="text-red-500">*</span></label>
          <div class="relative">
            <input type="password" id="pw1" name="password" placeholder="Tối thiểu 6 ký tự"
                   class="nt-input pr-10" required minlength="6" oninput="checkPw()">
            <button type="button" onclick="togglePw('pw1')"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <!-- Strength bar -->
          <div class="mt-2 h-1.5 rounded-full bg-gray-100 overflow-hidden">
            <div id="pwStrengthBar" class="h-full rounded-full transition-all duration-300" style="width:0%;background:#16a34a"></div>
          </div>
          <p id="pwStrengthText" class="text-xs text-gray-400 mt-1"></p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Xác nhận mật khẩu <span class="text-red-500">*</span></label>
          <div class="relative">
            <input type="password" id="pw2" name="confirmPassword" placeholder="••••••••"
                   class="nt-input pr-10" required minlength="6" oninput="checkPw()">
            <button type="button" onclick="togglePw('pw2')"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <p id="pwMatchText" class="text-xs mt-1"></p>
        </div>

        <button type="submit" id="regBtn"
                class="w-full py-3 rounded-xl text-white font-bold text-sm transition-all mt-2"
                style="background:linear-gradient(135deg,#16a34a,#059669);box-shadow:0 4px 16px rgba(22,163,74,0.3)">
          Tạo Tài Khoản →
        </button>
      </form>

      <div class="relative my-5">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-100"></div></div>
        <div class="relative flex justify-center">
          <span class="bg-white px-3 text-xs text-gray-400 font-semibold">HOẶC</span>
        </div>
      </div>

      <p class="text-center text-sm text-gray-500">
        Đã có tài khoản?
        <a href="/dang-nhap" class="font-bold text-green-600 hover:underline">Đăng nhập ngay</a>
      </p>
    </div>
  </div>
</div>

<script>
function togglePw(id) {
  const el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
}

function checkPw() {
  const p1 = document.getElementById('pw1').value;
  const p2 = document.getElementById('pw2').value;
  // Strength
  const bar  = document.getElementById('pwStrengthBar');
  const text = document.getElementById('pwStrengthText');
  let score = 0;
  if (p1.length >= 6)  score++;
  if (p1.length >= 10) score++;
  if (/[A-Z]/.test(p1)) score++;
  if (/[0-9]/.test(p1)) score++;
  if (/[^A-Za-z0-9]/.test(p1)) score++;
  const levels = [
    {w:'0%', c:'#e5e7eb', t:''},
    {w:'20%', c:'#ef4444', t:'Rất yếu'},
    {w:'40%', c:'#f59e0b', t:'Yếu'},
    {w:'60%', c:'#eab308', t:'Trung bình'},
    {w:'80%', c:'#22c55e', t:'Mạnh'},
    {w:'100%',c:'#16a34a', t:'Rất mạnh'},
  ];
  const lv = levels[Math.min(score, 5)];
  bar.style.width = p1 ? lv.w : '0%';
  bar.style.background = lv.c;
  text.textContent = p1 ? lv.t : '';
  text.style.color = lv.c;
  // Match
  const mt = document.getElementById('pwMatchText');
  if (p2) {
    if (p1 === p2) { mt.textContent = '✅ Mật khẩu khớp'; mt.style.color='#16a34a'; }
    else           { mt.textContent = '❌ Mật khẩu không khớp'; mt.style.color='#ef4444'; }
  } else { mt.textContent = ''; }
}

document.getElementById('registerForm').addEventListener('submit', (e) => {
  const p1 = document.getElementById('pw1').value;
  const p2 = document.getElementById('pw2').value;
  if (p1 !== p2) { e.preventDefault(); alert('Mật khẩu xác nhận không khớp!'); return; }
  const btn = document.getElementById('regBtn');
  btn.textContent = '⏳ Đang tạo tài khoản...';
  btn.disabled = true;
});
</script>

<%- include('../partials/footer') %>
